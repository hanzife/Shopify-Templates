<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">

    <link rel="canonical" href="{{ canonical_url }}">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}


   <style>
      body {
        margin: 0 !important;
        padding: 0 !important;
        max-width: 100% !important;
        overflow-x: clip !important;
        background-color: #000000 !important; /* Ensures the page root is black */
      }

      #MainContent,
      .shopify-section {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .shopify-section:has(#HeroSection),
      .shopify-section:has([data-section-type="hero"]) {
        position: sticky;
        top: 0;
        z-index: 1;
        min-height: 100vh;
        will-change: transform;
      }

      /* Apply white background ONLY to regular content sections, excluding footers */
      #MainContent .shopify-section:not(:has(#HeroSection)):not(:has([data-section-type="hero"])):not(:has(footer)):not([id*="footer"]) {
        position: relative;
        z-index: 2;
        background-color: var(--gradient-background, #ffffff);
        box-shadow: none !important;
      }

      /* Target ONLY the section immediately following the Hero for the top shadow */
      .shopify-section:has(#HeroSection) + .shopify-section,
      .shopify-section:has([data-section-type="hero"]) + .shopify-section {
        box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.08) !important;
      }

      /* Full bleed containers */
      .page-width,
      .container,
      .wrapper {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
      }

      #MainContent > .shopify-section:has(#pp-{{ section.id }}),
      .shopify-section:has(.pp) {
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #MainContent > .shopify-section:has(.pp) {
        display: block !important;
        flex: 1 1 100% !important;
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      /* The section fills its parent, no viewport-width hacks */
      .pp {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
      }


    </style>


  </head>

  <body>
    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hero = document.getElementById('HeroSection');
    const header = document.getElementById('SiteHeader');
    const logo = document.getElementById('HeroMainLogo');
    const slot = document.getElementById('HeaderLogoSlot');
    const slotText = slot && slot.querySelector('.header__logo-text');
    const nextSection = hero?.closest('.shopify-section')?.nextElementSibling;

    function updateSolid() {
      if (!hero) {
        // Force solid state on pages without a hero (Collections, Pages, Cart, etc.)
        header.classList.add('is-solid');
        if (logo) logo.classList.add('is-solid');
        return;
      }
      if (!nextSection || !header) return;
      const solid = nextSection.getBoundingClientRect().top <= header.offsetHeight;
      header.classList.toggle('is-solid', solid);
      if (logo) logo.classList.toggle('is-solid', solid);
    }

    if (!header || !logo || !slot || !slotText) return;

    // If there is no hero section at all, dock the logo immediately
    if (!hero) {
      document.documentElement.classList.add('pp-header-adapt');
      header.classList.add('is-solid');
      logo.classList.add('is-solid');
      
      const dockInstant = () => {
        logo.style.transition = 'none';
        const r = slot.getBoundingClientRect();
        const from = parseFloat(getComputedStyle(logo).fontSize);
        const to = parseFloat(getComputedStyle(slotText).fontSize);
        logo.style.setProperty('--logo-x', r.left + r.width / 2 + 'px');
        logo.style.setProperty('--logo-y', r.top + r.height / 2 + 'px');
        logo.style.setProperty('--logo-scale', to / from);
        logo.classList.add('is-docked');
        requestAnimationFrame(() => requestAnimationFrame(() => { logo.style.transition = ''; }));
      };
      dockInstant();
      window.addEventListener('resize', dockInstant);
      return; // Exit script early since we don't need scroll-tracking for hero animations
    }

    // --- Original Hero Scroll Animation Logic ---
    const THRESHOLD = 24;
    let start = { x: 0, y: 0 };
    let dock = { x: 0, y: 0 };
    let scale = 0.2;
    let docked = null;

    function measure() {
      start.x = document.documentElement.clientWidth / 2;
      start.y = hero.offsetHeight / 2;

      const r = slot.getBoundingClientRect();
      dock.x = r.left + r.width / 2;
      dock.y = r.top + r.height / 2;

      const from = parseFloat(getComputedStyle(logo).fontSize);
      const to = parseFloat(getComputedStyle(slotText).fontSize);
      scale = to / from;
    }

    function apply(force) {
      const next = window.scrollY > THRESHOLD;
      if (!force && next === docked) return;
      docked = next;

      const p = docked ? dock : start;
      logo.style.setProperty('--logo-x', p.x + 'px');
      logo.style.setProperty('--logo-y', p.y + 'px');
      logo.style.setProperty('--logo-scale', docked ? scale : 1);
      logo.classList.toggle('is-docked', docked);
    }

    logo.style.transition = 'none';
    measure();
    apply(true);
    updateSolid();

    requestAnimationFrame(() => requestAnimationFrame(() => { logo.style.transition = ''; }));

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => { 
        measure(); 
        apply(true); 
        updateSolid();
      });
    }

    window.addEventListener('scroll', () => {
      apply(false);
      updateSolid();
    }, { passive: true });

    window.addEventListener('resize', () => { 
      measure(); 
      apply(true); 
      updateSolid();
    });
  });
</script>

  </body>
</html>