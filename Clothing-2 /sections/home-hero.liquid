{% liquid
  assign video_src = ''
  
  if section.settings.video_file != blank
    assign video_src = section.settings.video_file
  elsif section.settings.video_url != blank
    assign video_src = section.settings.video_url
  else
{% assign video_src = 'hero-video.webm' | asset_url %}
  endif

%}

<section class="hero-video" id="HeroSection">
  {% if section.settings.video_file != blank %}
    {{
      section.settings.video_file
      | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        playsinline: true,
        controls: false,
        preload: 'auto',
        class: 'hero-video__bg'
    }}
  {% else %}
    <video
      class="hero-video__bg"
      autoplay
      loop
      muted
      playsinline
      preload="auto">
      <source src="{{ video_src }}" type="video/mp4">
    </video>
  {% endif %}

  <!-- 10% Dark Overlay -->
  <div class="hero-video__overlay"></div>

</section>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@900&display=swap');

  .hero-video {
    position: relative;
    width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-video__bg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .hero-video__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.10);
    z-index: 2;
  }

  .hero-video__content {
    position: relative;
    z-index: 3;
    text-align: center;
  }

 .hero-video__logo {
  --logo-x: 50vw;
  --logo-y: 50vh;
  --logo-scale: 1;

  position: fixed;
  top: 0;
  left: 0;
  z-index: 101; /* above the header and the featured section */
  margin: 0;
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  user-select: none;

  font-family: 'Archivo', sans-serif;
  font-weight: 900;
  font-size: clamp(4rem, 12vw, 10rem);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #f8f9fa;

  transform: translate(var(--logo-x), var(--logo-y)) translate(-50%, -50%) scale(var(--logo-scale));
  transform-origin: center;
  will-change: transform;
  transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1),
              color 0.9s cubic-bezier(0.65, 0, 0.35, 1);
}

.hero-video__logo.is-docked {
  color: #111111;
}

@media (prefers-reduced-motion: reduce) {
  .hero-video__logo { transition-duration: 0.01s; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Home Hero",
  "settings": [
    {
      "type": "video",
      "id": "video_file",
      "label": "Upload Video (MP4 / WebM)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "External Video URL",
      "info": "Overrides the default URL if provided and no file is uploaded above."
    }
  ],
  "presets": [
    {
      "name": "Home Hero"
    }
  ]
}
{% endschema %}