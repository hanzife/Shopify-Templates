<header class="site-header" id="SiteHeader">
  <div class="header__inner">

    <!-- Left navigation -->
    <nav class="header__nav-left">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="header__link">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <!-- Center slot: invisible target only, never displays anything -->
    <div class="header__logo-slot" id="HeaderLogoSlot" aria-hidden="true">
      <span class="header__logo-text">FOUND</span>
    </div>

    <!-- Right: wishlist, account, and cart -->
    <div class="header__icons">
      {%- comment -%} Wishlist Icon (placed before account icon) {%- endcomment -%}
      <a href="/pages/wishlist" class="header__icon-link" aria-label="Wishlist">
        <svg class="header__wishlist-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="header__icon-link" aria-label="Account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      {%- comment -%} Cart Drawer Trigger {%- endcomment -%}
      <button 
        type="button" 
        class="header__icon-link header__cart-trigger" 
        id="HeaderCartTrigger"
        aria-label="Open Cart">
        {% if cart.item_count > 0 %}
          <span class="cart-badge">{{ cart.item_count }}</span>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </button>
    </div>

  </div>
</header>

{%- comment -%}
  The ONE logo. Moved AFTER the header so the CSS sibling selector can target it.
  Position and animation are driven by the script in theme.liquid.
{%- endcomment -%}
<a href="{{ routes.root_url }}" class="brand-logo" id="HeroMainLogo">FOUND</a>

{% stylesheet %}
  /* ---------- Header bar ---------- */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 1.25rem 2rem;
    background: rgba(255, 255, 255, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0);
    transition: background 0.45s cubic-bezier(0.7, 0, 0.2, 1),
                backdrop-filter 0.45s cubic-bezier(0.7, 0, 0.2, 1),
                -webkit-backdrop-filter 0.45s cubic-bezier(0.7, 0, 0.2, 1),
                box-shadow 0.45s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .site-header.is-solid {
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05); 
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin: 0 auto;
  }

  /* ---------- Left nav ---------- */
  .header__nav-left {
    display: flex;
    gap: 2rem;
  }

  .header__link {
    font-family: sans-serif;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    transition: color 0.4s ease;
  }

  .site-header.is-solid .header__link {
    color: #111111;
  }

  /* ---------- Center slot (invisible target for the logo) ---------- */
  .header__logo-slot {
    visibility: hidden !important;
    opacity: 0 !important;
  }

  .header__logo-text {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: transparent;
  }

  /* ---------- The single travelling logo ---------- */
  .brand-logo {
    --logo-x: 50vw;
    --logo-y: 50vh;
    --logo-scale: 1;

    position: fixed;
    top: 0;
    left: 0;
    z-index: 101; /* above the header and the Featured section */
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    pointer-events: none;

    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: clamp(4rem, 12vw, 10rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #f8f9fa;

    transform: translate(var(--logo-x), var(--logo-y)) translate(-50%, -50%) scale(var(--logo-scale));
    transform-origin: center;
    will-change: transform;
    transition: transform 0.55s cubic-bezier(0.7, 0, 0.2, 1),
                color 0.4s ease;
  }

  .brand-logo.is-docked {
    pointer-events: auto;
  }

  /* Now successfully triggers because the logo is placed AFTER the header */
  .site-header.is-solid ~ .brand-logo {
    color: #111111;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo { transition-duration: 0.01s; }
  }

  /* ---------- Right icons ---------- */
  .header__icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }

  .header__icon-link {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #ffffff;
    display: flex;
    align-items: center;
    position: relative;
    transition: color 0.4s ease, transform 0.2s ease;
    text-decoration: none;
  }

  .header__icon-link:hover {
    transform: scale(1.08);
  }

  .site-header.is-solid .header__icon-link {
    color: #111111;
  }

  /* Universal rule: NO fills, ONLY clean strokes that strictly adapt to text color */
  .header__icon-link svg,
  .header__icon-link svg * {
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 2px !important;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .header__icon-link svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .cart-badge {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #ffffff;
    color: #000000;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .site-header.is-solid .cart-badge {
    background: #111111;
    color: #ffffff;
  }
{% endstylesheet %}

<script>
  (function () {
    if (window.__headerCartBound) return;
    window.__headerCartBound = true;

    // Delegated click: works on every page, even if the header re-renders
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest && e.target.closest('#HeaderCartTrigger');
      if (!trigger) return;
      e.preventDefault();

      if (typeof window.openCartDrawer === 'function') {
        window.openCartDrawer();
      } else {
        document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
      }
    });
  })();

  function addToCart(variantId) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
    })
    .then(res => res.json())
    .then((cartData) => {
      document.dispatchEvent(new CustomEvent('cart:open', {
        bubbles: true,
        detail: { cart: cartData }
      }));
    })
    .catch(err => console.error('Error adding to cart:', err));
  }
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Left navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}