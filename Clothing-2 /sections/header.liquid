{%- comment -%}
  The ONE logo. It starts centered over the hero, then docks into the header on scroll.
  Position and animation are driven by the script in theme.liquid.
{%- endcomment -%}
<a href="{{ routes.root_url }}" class="brand-logo" id="HeroMainLogo">VALOIS</a>

<header class="site-header" id="SiteHeader">
  <div class="header__inner">

    <!-- Left navigation -->
    <nav class="header__nav-left">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="header__link">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <!-- Center slot: invisible target only, never displays anything -->
    <div class="header__logo-slot" id="HeaderLogoSlot" aria-hidden="true">
      <span class="header__logo-text">VALOIS</span>
    </div>

    <!-- Right: account and cart -->
    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="header__icon-link" aria-label="Account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__icon-link" aria-label="Cart">
        {% if cart.item_count > 0 %}
          <span class="cart-badge">{{ cart.item_count }}</span>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>

  </div>
</header>

{% stylesheet %}
  /* ---------- Header bar ---------- */
  .site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  padding: 1.25rem 2rem;
  background: rgba(255, 255, 255, 0);
  backdrop-filter: blur(0px);
  -webkit-backdrop-filter: blur(0px);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0);
  transition: background 0.45s cubic-bezier(0.7, 0, 0.2, 1),
              backdrop-filter 0.45s cubic-bezier(0.7, 0, 0.2, 1),
              -webkit-backdrop-filter 0.45s cubic-bezier(0.7, 0, 0.2, 1),
              box-shadow 0.45s cubic-bezier(0.7, 0, 0.2, 1);
}

.site-header.is-solid {
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
}

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin: 0 auto;
  }

  /* ---------- Left nav ---------- */
  .header__nav-left {
    display: flex;
    gap: 2rem;
  }

  .header__link {
    font-family: sans-serif;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    transition: color 0.4s ease;
  }

  .site-header.is-solid .header__link {
    color: #111111;
  }

  /* ---------- Center slot (invisible target for the logo) ---------- */
  .header__logo-slot {
    visibility: hidden !important;
    opacity: 0 !important;
  }

  .header__logo-text {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: transparent;
  }

  /* ---------- The single travelling logo ---------- */
  .brand-logo {
    --logo-x: 50vw;
    --logo-y: 50vh;
    --logo-scale: 1;

    position: fixed;
    top: 0;
    left: 0;
    z-index: 101; /* above the header and the Featured section */
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    pointer-events: none;

    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: clamp(4rem, 12vw, 10rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #f8f9fa;

    transform: translate(var(--logo-x), var(--logo-y)) translate(-50%, -50%) scale(var(--logo-scale));
    transform-origin: center;
    will-change: transform;
    transition: transform 0.55s cubic-bezier(0.7, 0, 0.2, 1),
            color 0.4s ease;
  }

  .brand-logo.is-docked {
      pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo { transition-duration: 0.01s; }
  }

  /* ---------- Right icons ---------- */
  .header__icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }

  .header__icon-link {
    color: #ffffff;
    display: flex;
    align-items: center;
    position: relative;
    transition: color 0.4s ease;
  }

  .site-header.is-solid .header__icon-link {
    color: #111111;
  }

  .header__icon-link svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: currentColor;
  }

  .cart-badge {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #ffffff;
    color: #000000;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .site-header.is-solid .cart-badge {
    background: #111111;
    color: #ffffff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Left navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}