{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Text above the title",
      "info": "Optional, e.g. MEN'S. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "filter_title",
      "label": "Filter heading",
      "default": "Filter by"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "new_badge_days",
      "label": "NEW badge: products published in the last (days)",
      "info": "0 turns it off. Products tagged \"new\" always get the badge.",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "filters_open",
      "label": "Open the first 3 filter groups by default",
      "default": true
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#f7f7f7"
    }
  ]
}
