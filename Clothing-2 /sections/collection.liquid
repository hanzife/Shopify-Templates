{%- comment -%}
  Main Collection — full-width collection page
  - 100% body width: filters (25%) + product grid (75%, max 4 per row)
  - Filters come from Shopify's Storefront Filtering (collection.filters),
    so Size / Color / Price / Product type etc. are built from your products' variants
  - AJAX filtering + sorting + pagination (Section Rendering API), URLs stay shareable
  - Product card = "Goes well with" card: color swatches, quick-add size picker, wishlist, cart-drawer events
  - Mobile: filters open in a slide-in drawer
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800;900&display=swap" rel="stylesheet">

{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign new_days = section.settings.new_badge_days | default: 0 -%}
{%- assign now_seconds = 'now' | date: '%s' | plus: 0 -%}

{%- paginate collection.products by section.settings.products_per_page -%}

  {%- assign active_count = 0 -%}
  {%- for filter in collection.filters -%}
    {%- if filter.type == 'price_range' -%}
      {%- if filter.min_value.value != null or filter.max_value.value != null -%}
        {%- assign active_count = active_count | plus: 1 -%}
      {%- endif -%}
    {%- else -%}
      {%- assign active_count = active_count | plus: filter.active_values.size -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign shown_count = paginate.current_offset | plus: collection.products.size -%}

  <section
    class="gcp"
    id="gcp-{{ section.id }}"
    data-gcp
    data-section-id="{{ section.id }}"
    style="--gcp-bg: {{ section.settings.bg }};">

    <header class="gcp__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gcp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="gcp__title">{{ collection.title | escape }}</h1>
    </header>

    <div class="gcp__toolbar">
      <p class="gcp__count">
        <span class="gcp__count-label">Showing</span>
        <span data-gcp-count>{{ shown_count }} of {{ paginate.items }} products</span>
      </p>

      <div class="gcp__toolbar-actions">
        <button type="button" class="gcp__filter-btn" data-gcp-open-filters aria-controls="gcp-sidebar-{{ section.id }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="7" y1="12" x2="17" y2="12"></line><line x1="10" y1="17" x2="14" y2="17"></line></svg>
          Filter<span data-gcp-badge>{% if active_count > 0 %} ({{ active_count }}){% endif %}</span>
        </button>

        {%- if collection.sort_options.size > 0 -%}
          <div class="gcp-sort">
            <label for="gcp-sort-{{ section.id }}" class="visually-hidden">Sort by</label>
            <select
              id="gcp-sort-{{ section.id }}"
              class="gcp-sort__select"
              name="sort_by"
              form="gcp-form-{{ section.id }}"
              data-gcp-sort
              data-default="{{ collection.default_sort_by }}">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
            <svg class="gcp-sort__chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="gcp__layout">

      {%- comment -%} ============ FILTER SIDEBAR ============ {%- endcomment -%}
      <aside class="gcp__sidebar" id="gcp-sidebar-{{ section.id }}" data-gcp-sidebar aria-label="Filters">
        <form
          id="gcp-form-{{ section.id }}"
          class="gcp__form"
          action="{{ collection.url }}"
          method="get"
          data-gcp-form>

          <div class="gcp__sidebar-head">
            <h2 class="gcp__sidebar-title">{{ section.settings.filter_title | escape }}</h2>
            <button type="button" class="gcp__close" data-gcp-close-filters aria-label="Close filters">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
            </button>
          </div>

          <div data-gcp-groups>
            {%- for filter in collection.filters -%}
              {%- assign filter_label = filter.label | downcase -%}
              {%- assign is_color = false -%}
              {%- assign is_size = false -%}
              {%- if filter_label contains 'color' or filter_label contains 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
              {%- if filter_label contains 'size' -%}{%- assign is_size = true -%}{%- endif -%}

              <details
                class="gcp-group"
                data-gcp-group
                data-id="{{ filter.param_name | escape }}"
                {% if section.settings.filters_open and forloop.index <= 3 or filter.active_values.size > 0 %}open{% endif %}>
                <summary class="gcp-group__summary">
                  <span>{{ filter.label | escape }}</span>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>

                <div class="gcp-group__body">
                  {%- case filter.type -%}

                    {%- when 'price_range' -%}
                      <div class="gcp-price">
                        <label class="gcp-price__field">
                          <span class="gcp-price__symbol">{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            id="gcp-min-{{ section.id }}"
                            {% if filter.min_value.value != null %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                            placeholder="Min"
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            inputmode="decimal"
                            aria-label="Minimum price">
                        </label>
                        <span class="gcp-price__sep">to</span>
                        <label class="gcp-price__field">
                          <span class="gcp-price__symbol">{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            id="gcp-max-{{ section.id }}"
                            {% if filter.max_value.value != null %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                            placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            inputmode="decimal"
                            aria-label="Maximum price">
                        </label>
                      </div>

                    {%- else -%}
                      {%- if is_color -%}
                        <div class="gcp-fswatches">
                          {%- for value in filter.values -%}
                            {%- assign is_disabled = false -%}
                            {%- if value.count == 0 and value.active == false -%}{%- assign is_disabled = true -%}{%- endif -%}
                            <label class="gcp-fswatch{% if is_disabled %} is-disabled{% endif %}" title="{{ value.label | escape }}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value | escape }}"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}>
                              <span
                                class="gcp-fswatch__chip"
                                style="{% if value.swatch.image %}background-image: url('{{ value.swatch.image | image_url: width: 64 }}'); background-size: cover;{% elsif value.swatch.color %}background-color: {{ value.swatch.color }};{% else %}background-color: {{ value.label | handle }};{% endif %}"></span>
                              <span class="visually-hidden">{{ value.label | escape }} ({{ value.count }})</span>
                            </label>
                          {%- endfor -%}
                        </div>

                      {%- elsif is_size -%}
                        <div class="gcp-pills">
                          {%- for value in filter.values -%}
                            {%- assign is_disabled = false -%}
                            {%- if value.count == 0 and value.active == false -%}{%- assign is_disabled = true -%}{%- endif -%}
                            <label class="gcp-pill{% if is_disabled %} is-disabled{% endif %}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value | escape }}"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}>
                              <span class="gcp-pill__text">{{ value.label | escape }}</span>
                            </label>
                          {%- endfor -%}
                        </div>

                      {%- else -%}
                        <ul class="gcp-checks">
                          {%- for value in filter.values -%}
                            {%- assign is_disabled = false -%}
                            {%- if value.count == 0 and value.active == false -%}{%- assign is_disabled = true -%}{%- endif -%}
                            <li>
                              <label class="gcp-check{% if is_disabled %} is-disabled{% endif %}">
                                <input
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value | escape }}"
                                  {% if value.active %}checked{% endif %}
                                  {% if is_disabled %}disabled{% endif %}>
                                <span class="gcp-check__box" aria-hidden="true">
                                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"></polyline></svg>
                                </span>
                                <span class="gcp-check__label">{{ value.label | escape }}</span>
                                <span class="gcp-check__count">{{ value.count }}</span>
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          </div>

          <noscript>
            <button type="submit" class="gcp__apply">Apply filters</button>
          </noscript>
        </form>

        <div class="gcp__drawer-foot">
          <button type="button" class="gcp__apply" data-gcp-close-filters>
            Show <span data-gcp-apply>{{ paginate.items }}</span> products
          </button>
        </div>
      </aside>

      {%- comment -%} ============ PRODUCTS ============ {%- endcomment -%}
      <div class="gcp__main" data-gcp-results>

        <div class="gcp-active" data-gcp-active>
          {%- if active_count > 0 -%}
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                  <a class="gcp-chip" href="{{ filter.url_to_remove }}" data-gcp-link>
                    {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
                  </a>
                {%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  <a class="gcp-chip" href="{{ value.url_to_remove }}" data-gcp-link>
                    {{ value.label | escape }}
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
                  </a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            <a class="gcp-chip gcp-chip--clear" href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}" data-gcp-link>Clear all</a>
          {%- endif -%}
        </div>

        <div class="gcp-grid" data-gcp-grid>
          {%- for product in collection.products -%}

            {%- comment -%} NEW badge: tagged "new" or published within the last X days {%- endcomment -%}
            {%- assign is_new = false -%}
            {%- if product.tags contains 'new' or product.tags contains 'New' -%}
              {%- assign is_new = true -%}
            {%- elsif new_days > 0 and product.published_at -%}
              {%- assign published_seconds = product.published_at | date: '%s' | plus: 0 -%}
              {%- assign age_days = now_seconds | minus: published_seconds | divided_by: 86400 -%}
              {%- if age_days < new_days -%}{%- assign is_new = true -%}{%- endif -%}
            {%- endif -%}

            {%- assign has_size = false -%}
            {%- for option in product.options_with_values -%}
              {%- assign downcased_option = option.name | downcase -%}
              {%- if downcased_option contains 'size' -%}{%- assign has_size = true -%}{%- endif -%}
            {%- endfor -%}

            <div class="gcp-card" data-product-id="{{ product.id }}">
              <div class="gcp-card__image-wrapper">

                {%- comment -%} Wishlist Heart Button {%- endcomment -%}
                <button
                  type="button"
                  class="gcp-wishlist"
                  data-product-id="{{ product.id }}"
                  aria-label="Add to Wishlist">
                  <svg class="gcp-heart" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>

                {%- if is_new -%}
                  <span class="gcp-badge">New</span>
                {%- endif -%}

                <a href="{{ product.url }}" class="gcp-card__image-link" draggable="false">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      width="800"
                      height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
                      loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                      draggable="false"
                      class="gcp-card__img">
                  {%- else -%}
                    <div class="gcp-card__placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </a>

                {%- comment -%} Quick Add Hover Bar {%- endcomment -%}
                <div class="gcp-quick">
                  {%- if product.available == false -%}
                    <span class="gcp-quick__title">SOLD OUT</span>
                  {%- else -%}
                    <span class="gcp-quick__title">QUICK ADD</span>
                    <div class="gcp-quick__sizes">
                      {%- if has_size -%}
                        {%- for option in product.options_with_values -%}
                          {%- assign downcased_option = option.name | downcase -%}
                          {%- if downcased_option contains 'size' -%}
                            {%- for value in option.values -%}
                              {%- assign value_name = value.name | default: value -%}
                              <button
                                type="button"
                                class="gcp-size"
                                data-size="{{ value_name | escape }}">
                                {{ value_name }}
                              </button>
                            {%- endfor -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- else -%}
                        <button type="button" class="gcp-size gcp-size--full" data-add-default>Add to cart</button>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>

              {%- comment -%} Color Swatches {%- endcomment -%}
              <div class="gcp-card__swatches">
                {%- for option in product.options_with_values -%}
                  {%- assign downcased_option = option.name | downcase -%}
                  {%- if downcased_option contains 'color' or downcased_option contains 'colour' -%}
                    {%- for value in option.values -%}
                      {%- assign value_name = value.name | default: value -%}
                      {%- assign variant_image_url = '' -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.options contains value_name and variant.featured_image != blank -%}
                          {%- assign variant_image_url = variant.featured_image | image_url: width: 800 -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}

                      <button
                        type="button"
                        class="gcp-swatch{% if forloop.first %} active{% endif %}"
                        data-color="{{ value_name | escape }}"
                        data-variant-img="{{ variant_image_url }}"
                        title="{{ value_name | escape }}"
                        aria-label="{{ value_name | escape }}"
                        style="background-color: {{ value.swatch.color | default: value_name | handle }};">
                      </button>
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- comment -%} Product Details {%- endcomment -%}
              <div class="gcp-card__info">
                <h3 class="gcp-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <span class="gcp-card__category">{{ product.type }}</span>
                <span class="gcp-card__color" data-gcp-color-label>
                  {%- for option in product.options_with_values -%}
                    {%- assign downcased_option = option.name | downcase -%}
                    {%- if downcased_option contains 'color' or downcased_option contains 'colour' -%}
                      {{ option.values.first }}
                    {%- endif -%}
                  {%- endfor -%}
                </span>
                <span class="gcp-card__price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price -%}
                    <s class="gcp-card__compare">{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </span>
              </div>

              <script type="application/json" class="gcp-variants-json">
                {{ product.variants | json }}
              </script>
            </div>

          {%- else -%}
            <div class="gcp-empty">
              <p class="gcp-empty__title">No products match these filters</p>
              <p class="gcp-empty__text">Remove a filter or clear them all to see everything in this collection.</p>
              <a class="gcp__apply gcp-empty__btn" href="{{ collection.url }}" data-gcp-link>Clear all filters</a>
            </div>
          {%- endfor -%}
        </div>

        <nav class="gcp-pagination" data-gcp-pagination aria-label="Pagination">
          {%- if paginate.pages > 1 -%}
            <ul>
              {%- if paginate.previous -%}
                <li><a href="{{ paginate.previous.url }}" data-gcp-link data-gcp-page aria-label="Previous page">&lsaquo;</a></li>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <li><a href="{{ part.url }}" data-gcp-link data-gcp-page>{{ part.title }}</a></li>
                {%- elsif part.title == paginate.current_page -%}
                  <li><span class="is-current" aria-current="page">{{ part.title }}</span></li>
                {%- else -%}
                  <li><span>{{ part.title }}</span></li>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <li><a href="{{ paginate.next.url }}" data-gcp-link data-gcp-page aria-label="Next page">&rsaquo;</a></li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </nav>
      </div>
    </div>

    <div class="gcp__overlay" data-gcp-overlay></div>
  </section>

{%- endpaginate -%}

{% stylesheet %}
  .gcp {
    --gcp-gap: 1.5rem;
    --gcp-cols: 4;
    --gcp-sticky-top: calc(var(--pp-header-h, 4rem) + 1.5rem);
    position: relative;
    z-index: 10;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    background-color: var(--gcp-bg, #f7f7f7);
    color: #111111;
    padding: calc(var(--pp-header-h, 4rem) + 2rem) 3rem 5rem;
    box-sizing: border-box;
    font-family: 'Archivo', sans-serif;
  }

  .gcp *, .gcp *::before, .gcp *::after { box-sizing: border-box; }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Header + toolbar ---------- */
  .gcp__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #111111;
  }

  .gcp__title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #111111;
  }

  .gcp__toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e3e3e3;
  }

  .gcp__count {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 1.1rem;
    color: #111111;
  }

  .gcp__count-label { font-size: 0.95rem; color: #8a8a8a; }

  .gcp__toolbar-actions { display: flex; align-items: center; gap: 0.75rem; }

  .gcp-sort { position: relative; }

  .gcp-sort__select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 1px solid #e3e3e3;
    border-radius: 8px;
    padding: 1.15rem 3rem 1.15rem 1.5rem;
    font-family: inherit;
    font-size: 1.1rem;
    color: #111111;
    cursor: pointer;
    min-width: 220px;
    transition: border-color 0.2s ease;
  }

  .gcp-sort__select:hover { border-color: #111111; }

  .gcp-sort__chev {
    position: absolute;
    right: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .gcp__filter-btn {
    display: none;
    align-items: center;
    gap: 0.5rem;
    background: #111111;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0.9rem 1.2rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
  }

  /* ---------- Layout: 25% filters / 75% products ---------- */
  .gcp__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 3rem;
    margin-top: 2.5rem;
    align-items: start;
  }

  .gcp__sidebar {
    position: sticky;
    top: var(--gcp-sticky-top);
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    scrollbar-width: thin;
    padding-right: 0.25rem;
  }

  .gcp__sidebar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .gcp__sidebar-title {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .gcp__close {
    display: none;
    background: none;
    border: none;
    padding: 0.25rem;
    cursor: pointer;
    color: #111111;
  }

  .gcp__drawer-foot { display: none; }

  /* ---------- Filter groups ---------- */
  .gcp-group { border-bottom: 1px solid #e3e3e3; }

  .gcp-group__summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.35rem 0;
    cursor: pointer;
    font-size: 1.15rem;
    font-weight: 800;
    color: #111111;
    user-select: none;
  }

  .gcp-group__summary::-webkit-details-marker { display: none; }
  .gcp-group__summary svg { transition: transform 0.25s ease; flex-shrink: 0; }
  .gcp-group[open] .gcp-group__summary svg { transform: rotate(180deg); }
  .gcp-group__summary:focus-visible { outline: 2px solid #111111; outline-offset: 2px; }

  .gcp-group__body { padding: 0 0 1.5rem; }

  /* Checkbox list */
  .gcp-checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; }

  .gcp-check {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .gcp-check input { position: absolute; opacity: 0; pointer-events: none; }

  .gcp-check__box {
    width: 18px; height: 18px;
    border: 1px solid #b9b9b9;
    border-radius: 4px;
    background: #ffffff;
    display: flex; align-items: center; justify-content: center;
    color: transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .gcp-check:hover .gcp-check__box { border-color: #111111; }
  .gcp-check input:checked + .gcp-check__box { background: #111111; border-color: #111111; color: #ffffff; }
  .gcp-check input:focus-visible + .gcp-check__box { outline: 2px solid #111111; outline-offset: 2px; }
  .gcp-check__label { flex: 1; color: #111111; }
  .gcp-check__count { color: #8a8a8a; font-size: 0.85rem; }
  .gcp-check.is-disabled { opacity: 0.4; cursor: not-allowed; }

  /* Size pills (same look as the quick-add sizes) */
  .gcp-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .gcp-pill { position: relative; cursor: pointer; }
  .gcp-pill input { position: absolute; opacity: 0; pointer-events: none; }

  .gcp-pill__text {
    display: flex; align-items: center; justify-content: center;
    min-width: 42px; height: 36px; padding: 0 0.6rem;
    background: #ffffff;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #111111;
    transition: all 0.2s ease;
  }

  .gcp-pill:hover .gcp-pill__text { border-color: #111111; }
  .gcp-pill input:checked + .gcp-pill__text { background: #111111; color: #ffffff; border-color: #111111; }
  .gcp-pill input:focus-visible + .gcp-pill__text { outline: 2px solid #111111; outline-offset: 2px; }
  .gcp-pill.is-disabled { opacity: 0.35; cursor: not-allowed; }
  .gcp-pill.is-disabled .gcp-pill__text { text-decoration: line-through; background: #f1f1f1; }

  /* Color swatches (same look as card swatches) */
  .gcp-fswatches { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .gcp-fswatch { position: relative; cursor: pointer; }
  .gcp-fswatch input { position: absolute; opacity: 0; pointer-events: none; }

  .gcp-fswatch__chip {
    display: block;
    width: 28px; height: 28px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background-position: center;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .gcp-fswatch:hover .gcp-fswatch__chip { border-color: #111111; }
  .gcp-fswatch input:checked + .gcp-fswatch__chip { border-color: #111111; box-shadow: 0 0 0 2px var(--gcp-bg, #f7f7f7), 0 0 0 3px #111111; }
  .gcp-fswatch input:focus-visible + .gcp-fswatch__chip { outline: 2px solid #111111; outline-offset: 3px; }
  .gcp-fswatch.is-disabled { opacity: 0.3; cursor: not-allowed; }

  /* Price */
  .gcp-price { display: flex; align-items: center; gap: 0.6rem; }
  .gcp-price__sep { color: #8a8a8a; font-size: 0.85rem; }

  .gcp-price__field {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #ffffff;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    padding: 0 0.65rem;
    height: 42px;
    transition: border-color 0.2s ease;
  }

  .gcp-price__field:focus-within { border-color: #111111; }
  .gcp-price__symbol { color: #8a8a8a; font-size: 0.9rem; }

  .gcp-price__field input {
    width: 100%;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: inherit;
    font-size: 0.95rem;
    color: #111111;
    -moz-appearance: textfield;
  }

  .gcp-price__field input::-webkit-outer-spin-button,
  .gcp-price__field input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* ---------- Results ---------- */
  .gcp__main { min-width: 0; transition: opacity 0.2s ease; }
  .gcp__main.is-loading { opacity: 0.45; pointer-events: none; }

  .gcp-active { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .gcp-active:not(:empty) { margin-bottom: 1.5rem; }

  .gcp-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #111111;
    color: #ffffff;
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .gcp-chip:hover { background: #333333; }

  .gcp-chip--clear {
    background: transparent;
    color: #111111;
    border: 1px solid #cfcfcf;
  }

  .gcp-chip--clear:hover { background: #ffffff; border-color: #111111; }

  .gcp-grid {
    display: grid;
    grid-template-columns: repeat(var(--gcp-cols), minmax(0, 1fr));
    gap: var(--gcp-gap);
  }

  .gcp-empty {
    grid-column: 1 / -1;
    padding: 5rem 1rem;
    text-align: center;
  }

  .gcp-empty__title { margin: 0 0 0.5rem; font-size: 1.4rem; font-weight: 800; }
  .gcp-empty__text { margin: 0 0 1.5rem; color: #666666; }

  /* ---------- Product card (from "Goes well with") ---------- */
  .gcp-card {
    display: flex;
    flex-direction: column;
    position: relative;
    background: #ffffff;
    border-radius: 8px;
    padding: 0.75rem;
    min-width: 0;
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gcp-card:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    transform: translateY(-3px);
  }

  .gcp-card__image-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f6f6f6;
    margin-bottom: 0.75rem;
    position: relative;
    border-radius: 6px;
  }

  .gcp-card__image-link { display: block; width: 100%; height: 100%; }

  .gcp-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .gcp-card__placeholder { width: 100%; height: 100%; }
  .gcp-card__placeholder svg { width: 100%; height: 100%; }

  .gcp-badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 4;
    background: #ffffff;
    border: 1px solid #e2e2e2;
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #111111;
    pointer-events: none;
  }

  /* Wishlist */
  .gcp-wishlist {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    backdrop-filter: blur(4px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    color: #111111;
    padding: 0;
  }

  .gcp-wishlist:hover { transform: scale(1.1); background: #ffffff; }
  .gcp-wishlist.active { color: #ff3b30; }
  .gcp-wishlist.active .gcp-heart { fill: #ff3b30; stroke: #ff3b30; }

  /* Quick add */
  .gcp-quick {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #ffffff;
    padding: 0.85rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border-top: 1px solid #f0f0f0;
    z-index: 5;
  }

  .gcp-card__image-wrapper:hover .gcp-quick,
  .gcp-card__image-wrapper:focus-within .gcp-quick { transform: translateY(0); }

  .gcp-quick__title {
    font-size: 0.7rem;
    font-weight: 800;
    color: #111111;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gcp-quick__sizes { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .gcp-size {
    background: #f8f8f8;
    border: 1px solid #e2e2e2;
    color: #111111;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    min-width: 38px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .gcp-size--full { flex: 1; padding: 0 0.75rem; }

  .gcp-size:hover:not(.disabled) { border-color: #111111; background: #111111; color: #ffffff; }
  .gcp-size.active { background: #111111; color: #ffffff; border-color: #111111; }

  .gcp-size.disabled {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
    background: #f1f1f1;
    border-color: #e5e5e5;
  }

  /* Swatches */
  .gcp-card__swatches { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 0.5rem; min-height: 18px; }

  .gcp-swatch {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
    padding: 0;
  }

  .gcp-swatch.active { border-color: #111111; box-shadow: 0 0 0 1px #111111; }

  /* Info */
  .gcp-card__info { display: flex; flex-direction: column; gap: 0.15rem; }

  .gcp-card__title {
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
    color: #111111;
  }

  .gcp-card__title a { color: inherit; text-decoration: none; }

  .gcp-card__category,
  .gcp-card__color { font-size: 0.8rem; color: #666666; }

  .gcp-card__price { font-weight: 800; font-size: 0.9rem; color: #111111; margin-top: 0.2rem; }
  .gcp-card__compare { font-weight: 500; color: #8a8a8a; margin-left: 0.4rem; }

  /* ---------- Buttons + pagination ---------- */
  .gcp__apply {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: auto;
    background: #111111;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 1rem 1.5rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .gcp__apply:hover { background: #333333; }

  .gcp-pagination ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 3rem 0 0;
    padding: 0;
  }

  .gcp-pagination a,
  .gcp-pagination span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 42px;
    padding: 0 0.6rem;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    background: #ffffff;
    color: #111111;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .gcp-pagination a:hover { border-color: #111111; }
  .gcp-pagination .is-current { background: #111111; color: #ffffff; border-color: #111111; }

  /* ---------- Responsive ---------- */
  @media screen and (max-width: 1280px) {
    .gcp { --gcp-cols: 3; }
  }

  @media screen and (max-width: 900px) {
    .gcp { 
      --gcp-cols: 2; 
      padding: calc(var(--pp-header-h, 4rem) + 1.25rem) 1.25rem 4rem; 
    }

    .gcp__layout { grid-template-columns: minmax(0, 1fr); margin-top: 1.5rem; }
    .gcp__toolbar { margin-top: 1.75rem; padding-bottom: 1.25rem; }
    .gcp__filter-btn { display: inline-flex; }
    .gcp-sort__select { min-width: 0; padding: 0.85rem 2.5rem 0.85rem 1rem; font-size: 0.95rem; }
    .gcp-sort__chev { right: 0.75rem; }

    .gcp__sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 1001;
      width: min(88vw, 400px);
      max-height: none;
      height: 100%;
      background: #ffffff;
      padding: 1.25rem 1.25rem 6rem;
      transform: translateX(-100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      visibility: hidden;
    }

    .gcp.is-filters-open .gcp__sidebar { transform: translateX(0); visibility: visible; }

    .gcp__close { display: block; }
    .gcp__sidebar-title { font-size: 1.5rem; }

    .gcp__drawer-foot {
      display: block;
      position: fixed;
      left: 0;
      bottom: 0;
      width: min(88vw, 400px);
      padding: 1rem 1.25rem;
      background: #ffffff;
      border-top: 1px solid #e3e3e3;
      z-index: 1002;
      transform: translateX(-100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      visibility: hidden;
    }

    .gcp.is-filters-open .gcp__drawer-foot { transform: translateX(0); visibility: visible; }
    .gcp__drawer-foot .gcp__apply { width: 100%; }

    .gcp__overlay {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .gcp.is-filters-open .gcp__overlay { opacity: 1; pointer-events: auto; }
  }

  @media screen and (max-width: 600px) {
    .gcp { --gcp-gap: 0.75rem; }
    .gcp-card { padding: 0.5rem; }
    .gcp-card__title { font-size: 0.8rem; letter-spacing: 0.03em; }
  }

  /* Touch screens have no hover: keep quick-add reachable */
  @media (hover: none) {
    .gcp-quick { transform: translateY(0); padding: 0.5rem; gap: 0.35rem; }
    .gcp-quick__title { display: none; }
    .gcp-size { min-width: 32px; height: 28px; font-size: 0.7rem; }
    .gcp-badge { bottom: auto; top: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gcp *, .gcp *::before, .gcp *::after { transition-duration: 0.01ms !important; }
  }
{% endstylesheet %}

<script>
  (function () {
    const root = document.getElementById('gcp-{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const sectionId = root.dataset.sectionId;
    const form = root.querySelector('[data-gcp-form]');
    const results = root.querySelector('[data-gcp-results]');
    const sortSelect = root.querySelector('[data-gcp-sort]');

    // Parts of the page that get swapped after every filter / sort / page change
    const REPLACE = [
      '[data-gcp-count]',
      '[data-gcp-badge]',
      '[data-gcp-apply]',
      '[data-gcp-groups]',
      '[data-gcp-active]',
      '[data-gcp-grid]',
      '[data-gcp-pagination]'
    ];

    // =========================================================
    //  PRODUCT CARDS (swatches, quick-add sizes, wishlist, cart)
    // =========================================================
    function getWishlist() {
      try { return JSON.parse(localStorage.getItem('shopify_wishlist')) || []; } catch (e) { return []; }
    }

    function setWishlist(list) {
      try { localStorage.setItem('shopify_wishlist', JSON.stringify(list)); } catch (e) {}
    }

    function bindCards(scope) {
      scope.querySelectorAll('.gcp-card:not([data-bound])').forEach(card => {
        card.dataset.bound = '1';

        const productId = card.dataset.productId;
        const variants = JSON.parse(card.querySelector('.gcp-variants-json').textContent);
        const colorSwatches = card.querySelectorAll('.gcp-swatch');
        const sizeBtns = card.querySelectorAll('.gcp-size');
        const img = card.querySelector('.gcp-card__img');
        const wishlistBtn = card.querySelector('.gcp-wishlist');
        const colorLabel = card.querySelector('[data-gcp-color-label]');

        let selectedColor = colorSwatches.length > 0 ? colorSwatches[0].dataset.color : null;
        let selectedSize = null;

        // Wishlist
        if (wishlistBtn) {
          if (getWishlist().includes(productId)) wishlistBtn.classList.add('active');

          wishlistBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            let list = getWishlist();
            if (list.includes(productId)) {
              list = list.filter(id => id !== productId);
              wishlistBtn.classList.remove('active');
            } else {
              list.push(productId);
              wishlistBtn.classList.add('active');
            }
            setWishlist(list);
          });
        }

        function findVariant(color, size) {
          return variants.find(v => {
            const opts = v.options.map(o => o.toLowerCase());
            const matchesColor = !color || opts.includes(color.toLowerCase());
            const matchesSize = !size || opts.includes(size.toLowerCase());
            return matchesColor && matchesSize;
          });
        }

        function updateSizeAvailability() {
          sizeBtns.forEach(btn => {
            if (btn.dataset.addDefault !== undefined) return;
            const matchingVariant = findVariant(selectedColor, btn.dataset.size);
            if (!matchingVariant || !matchingVariant.available) {
              btn.classList.add('disabled');
            } else {
              btn.classList.remove('disabled');
            }
          });
        }

        updateSizeAvailability();

        // Color swatches
        colorSwatches.forEach(swatch => {
          swatch.addEventListener('click', (e) => {
            e.preventDefault();
            colorSwatches.forEach(s => s.classList.remove('active'));
            swatch.classList.add('active');

            selectedColor = swatch.dataset.color;
            if (colorLabel) colorLabel.textContent = selectedColor;

            const newImgSrc = swatch.dataset.variantImg;
            if (newImgSrc && img) img.src = newImgSrc;

            updateSizeAvailability();
          });
        });

        // Sizes -> add to cart
        sizeBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            if (btn.classList.contains('disabled')) return;

            let matchedVariant;

            if (btn.dataset.addDefault !== undefined) {
              // Products without a size option: add the first available variant (of the selected color)
              matchedVariant = variants.find(v => v.available &&
                (!selectedColor || v.options.map(o => o.toLowerCase()).includes(selectedColor.toLowerCase())));
            } else {
              sizeBtns.forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              selectedSize = btn.dataset.size;
              matchedVariant = findVariant(selectedColor, selectedSize);
            }

            if (matchedVariant && matchedVariant.available) {
              addToCart(matchedVariant.id);
            } else {
              console.warn('Variant unavailable or not found for:', selectedColor, selectedSize);
            }
          });
        });
      });
    }

    // ---------- Add to cart + theme events (same as Goes Well With) ----------
    function addToCart(variantId) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(res => {
        if (!res.ok) throw new Error('Cart add failed (' + res.status + ')');
        return res.json();
      })
      .then(cartData => {
        document.dispatchEvent(new CustomEvent('cart:open', {
          bubbles: true,
          detail: { variantId: variantId, cart: cartData }
        }));

        document.dispatchEvent(new CustomEvent('cart:refresh', {
          bubbles: true,
          detail: { cart: cartData }
        }));

        document.dispatchEvent(new CustomEvent('cart:updated', {
          bubbles: true,
          detail: { cart: cartData }
        }));

        if (window.Shopify && Shopify.theme && Shopify.theme.cart) {
          document.querySelector('cart-drawer')?.open();
        }
      })
      .catch(err => console.error('Error adding to cart:', err));
    }

    // =========================================================
    //  FILTERING / SORTING / PAGINATION (Section Rendering API)
    // =========================================================
    let controller = null;

    function getParams() {
      const params = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (value !== '') params.append(key, value);
      });
      return params;
    }

    async function update(params, push) {
      const base = form.getAttribute('action');
      const qs = params.toString();
      const pageUrl = base + (qs ? '?' + qs : '');
      const fetchUrl = base + '?' + (qs ? qs + '&' : '') + 'section_id=' + encodeURIComponent(sectionId);

      if (controller) controller.abort();
      const ctrl = controller = new AbortController();
      results.classList.add('is-loading');

      try {
        const res = await fetch(fetchUrl, { signal: ctrl.signal });
        if (!res.ok) throw new Error('Request failed (' + res.status + ')');
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');

        // Remember which filter groups are open + what had focus
        const openState = {};
        root.querySelectorAll('[data-gcp-group]').forEach(d => { openState[d.dataset.id] = d.open; });
        const focusedId = document.activeElement && root.contains(document.activeElement) ? document.activeElement.id : null;

        REPLACE.forEach(sel => {
          const current = root.querySelector(sel);
          const next = doc.querySelector(sel);
          if (current && next) current.innerHTML = next.innerHTML;
        });

        root.querySelectorAll('[data-gcp-group]').forEach(d => {
          if (d.dataset.id in openState) d.open = openState[d.dataset.id];
        });

        if (focusedId) {
          const el = document.getElementById(focusedId);
          if (el) el.focus({ preventScroll: true });
        }

        if (sortSelect) sortSelect.value = params.get('sort_by') || sortSelect.dataset.default;

        bindCards(root);

        if (push) history.pushState({ gcp: true }, '', pageUrl);
      } catch (err) {
        if (err.name !== 'AbortError') {
          console.error('Collection update failed, falling back to full reload:', err);
          window.location.href = pageUrl;
        }
      } finally {
        if (controller === ctrl) results.classList.remove('is-loading');
      }
    }

    // Any filter / sort / price change
    root.addEventListener('change', (e) => {
      if (e.target.form === form) update(getParams(), true);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      update(getParams(), true);
    });

    // Chips, "clear all" and pagination links
    root.addEventListener('click', (e) => {
      const link = e.target.closest('a[data-gcp-link]');
      if (!link) return;
      e.preventDefault();

      const url = new URL(link.href, window.location.origin);
      update(new URLSearchParams(url.search), true);

      if (link.hasAttribute('data-gcp-page')) {
        root.querySelector('.gcp__layout').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    window.addEventListener('popstate', () => {
      update(new URLSearchParams(window.location.search), false);
    });

    // =========================================================
    //  MOBILE FILTER DRAWER
    // =========================================================
    function setDrawer(open) {
      root.classList.toggle('is-filters-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }

    root.addEventListener('click', (e) => {
      if (e.target.closest('[data-gcp-open-filters]')) setDrawer(true);
      else if (e.target.closest('[data-gcp-close-filters]') || e.target.closest('[data-gcp-overlay]')) setDrawer(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-filters-open')) setDrawer(false);
    });

    window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
      if (e.matches) setDrawer(false);
    });

    // Init
    bindCards(root);
  })();
</script>

