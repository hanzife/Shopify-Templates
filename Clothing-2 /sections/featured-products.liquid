<section class="featured-products" id="FeaturedProducts">
  <div class="featured-products__header">
    <h2 class="featured-products__title">{{ section.settings.title | escape }}</h2>
  </div>

  <div class="featured-products__grid">
    {%- assign collection = section.settings.collection -%}
    {%- assign products_to_show = collections.all.products -%}
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- assign products_to_show = collection.products -%}
    {%- endif -%}

    {%- for product in products_to_show limit: 4 -%}
      <div class="product-card" data-product-id="{{ product.id }}">
        <div class="product-card__image-wrapper">
          
          {%- comment -%} Wishlist Heart Button {%- endcomment -%}
          <button 
            type="button" 
            class="wishlist-btn" 
            data-product-id="{{ product.id }}" 
            aria-label="Add to Wishlist">
            <svg class="heart-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </button>

          {%- comment -%} Smooth Sliding Gallery Track {%- endcomment -%}
          <a href="{{ product.url }}" class="product-card__gallery-slider">
            <div class="product-card__track">
              {%- if product.images.size > 0 -%}
                {%- for image in product.images limit: 3 -%}
                  <img 
                    src="{{ image | image_url: width: 800 }}" 
                    alt="{{ image.alt | escape }}" 
                    loading="lazy"
                    class="product-card__slide-img"
                    id="ProductImage-{{ product.id }}-{{ forloop.index0 }}">
                {%- endfor -%}
              {%- else -%}
                <div class="product-card__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
          </a>

          {%- comment -%} Quick Add Hover Bar on Bottom of Image {%- endcomment -%}
          <div class="quick-add-bar">
            <span class="quick-add-title">QUICK ADD</span>
            <div class="quick-add-sizes">
              {%- for option in product.options_with_values -%}
                {%- assign downcased_option = option.name | downcase -%}
                {%- if downcased_option contains 'size' -%}
                  {%- for value in option.values -%}
                    <button 
                      type="button" 
                      class="size-btn" 
                      data-size="{{ value | escape }}">
                      {{ value }}
                    </button>
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>

        {%- comment -%} Color Swatches Below Image {%- endcomment -%}
        <div class="product-card__swatches">
          {%- for option in product.options_with_values -%}
            {%- assign downcased_option = option.name | downcase -%}
            {%- if downcased_option contains 'color' or downcased_option contains 'colour' -%}
              {%- for value in option.values -%}
                {%- assign variant_image_url = '' -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options contains value and variant.featured_image != blank -%}
                    {%- assign variant_image_url = variant.featured_image | image_url: width: 800 -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

                <button 
                  type="button" 
                  class="color-swatch{% if forloop.first %} active{% endif %}" 
                  data-color="{{ value | escape }}" 
                  data-variant-img="{{ variant_image_url }}"
                  title="{{ value | escape }}"
                  style="background-color: {{ value | handle }};">
                </button>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Product Details {%- endcomment -%}
        <div class="product-card__info">
          <h3 class="product-card__title">{{ product.title }}</h3>
          <span class="product-card__category">{{ product.type }}</span>
          <span class="product-card__selected-color" id="SelectedColor-{{ product.id }}">
            {%- for option in product.options_with_values -%}
              {%- assign downcased_option = option.name | downcase -%}
              {%- if downcased_option contains 'color' or downcased_option contains 'colour' -%}
                {{ option.values.first }}
              {%- endif -%}
            {%- endfor -%}
          </span>
          <span class="product-card__price">{{ product.price | money }}</span>
        </div>

        {%- comment -%} Store raw variants JSON for JavaScript interaction {%- endcomment -%}
        <script type="application/json" class="product-variants-json">
          {{ product.variants | json }}
        </script>
      </div>
    {%- endfor -%}
  </div>
</section>

{%- comment -%} Sliding Cart Drawer Markup {%- endcomment -%}
<div class="cart-drawer-overlay" id="CartDrawerOverlay"></div>
<div class="cart-drawer" id="CartDrawer">
  <div class="cart-drawer__header">
    <h3>Your cart (<span id="CartDrawerCount">0</span>)</h3>
    <button type="button" class="cart-drawer__close" id="CartDrawerClose">&times;</button>
  </div>
  <div class="cart-drawer__content" id="CartDrawerContent"></div>
  <div class="cart-drawer__footer">
    <div class="cart-drawer__subtotal">
      <span>Subtotal</span>
      <strong id="CartDrawerSubtotal">$0.00</strong>
    </div>
    <a href="/checkout" class="cart-drawer__checkout-btn">CHECKOUT</a>
    <a href="/cart" class="cart-drawer__view-cart-btn">VIEW CART</a>
  </div>
</div>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&display=swap');

  .featured-products {
    position: relative;
    z-index: 10;
    width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
    background-color: #ffffff;
    color: #111111;
    padding: 4rem 3rem 6rem 3rem;
  }

  .featured-products__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .featured-products__title {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
    color: #111111;
  }

  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  @media screen and (max-width: 1024px) {
    .featured-products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .featured-products__grid {
      grid-template-columns: 1fr;
    }
    .featured-products {
      padding: 3rem 1rem 4rem 1rem;
    }
  }

  /* Product Card Container & Hover Shadow */
  .product-card {
    display: flex;
    flex-direction: column;
    position: relative;
    background: #ffffff;
    border-radius: 8px;
    padding: 0.75rem;
    width: 100%;
    box-sizing: border-box;
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    transform: translateY(-3px);
  }

  .product-card__image-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f6f6f6;
    margin-bottom: 0.75rem;
    position: relative;
    border-radius: 6px;
  }

  /* Wishlist Heart Button */
  .wishlist-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    backdrop-filter: blur(4px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    color: #111111;
  }

  .wishlist-btn:hover {
    transform: scale(1.1);
    background: #ffffff;
  }

  .wishlist-btn.active {
    color: #ff3b30;
  }

  .wishlist-btn.active .heart-icon {
    fill: #ff3b30;
    stroke: #ff3b30;
  }

  /* Smooth Slider Track */
  .product-card__gallery-slider {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .product-card__track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  .product-card__slide-img {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    object-fit: cover;
  }

  /* Hover Quick Add Overlay */
  .quick-add-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #ffffff;
    padding: 0.85rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    border-top: 1px solid #f0f0f0;
    z-index: 5;
  }

  .product-card__image-wrapper:hover .quick-add-bar {
    transform: translateY(0);
  }

  .quick-add-title {
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    color: #111111;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .quick-add-sizes {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .size-btn {
    background: #f8f8f8;
    border: 1px solid #e2e2e2;
    color: #111111;
    font-family: 'Archivo', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    min-width: 38px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .size-btn:hover:not(.disabled) {
    border-color: #111111;
    background: #111111;
    color: #ffffff;
  }

  .size-btn.active {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
  }

  .size-btn.disabled {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
    background: #f1f1f1;
    border-color: #e5e5e5;
  }

  /* Color Swatches Below Image */
  .product-card__swatches {
    display: flex;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
  }

  .color-swatch {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
    padding: 0;
  }

  .color-swatch.active {
    border-color: #111111;
    box-shadow: 0 0 0 1px #111111;
  }

  /* Card Info */
  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .product-card__title {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
    color: #111111;
  }

  .product-card__category, .product-card__selected-color {
    font-family: 'Archivo', sans-serif;
    font-size: 0.8rem;
    color: #666666;
  }

  .product-card__price {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 0.9rem;
    color: #111111;
    margin-top: 0.2rem;
  }

  /* Smooth Cart Drawer Overlay */
  .cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.32, 0.72, 0, 1), visibility 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .cart-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* Ultra-Smooth Slide Right-to-Left Cart Drawer */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 420px;
    max-width: 90vw;
    height: 100vh;
    background: #ffffff;
    color: #111111;
    z-index: 1000;
    transform: translate3d(100%, 0, 0); /* Hardware accelerated 3D transform */
    transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1); /* Silky ease-out curve */
    will-change: transform;
    display: flex;
    flex-direction: column;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.12);
  }

  .cart-drawer.active {
    transform: translate3d(0, 0, 0);
  }

  .cart-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid #eee;
  }

  .cart-drawer__header h3 {
    margin: 0;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
  }

  .cart-drawer__close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  .cart-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  /* Cart Drawer Item Layout */
  .cart-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #eee;
    position: relative;
    align-items: flex-start;
  }

  .cart-item img {
    width: 75px;
    height: 95px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .cart-item__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-right: 0.5rem;
  }

  .cart-item__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.25rem;
    width: 100%;
  }

  .cart-item__title {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    color: #111111;
    line-height: 1.3;
    flex: 1;
  }

  .cart-item__option {
    font-family: 'Archivo', sans-serif;
    font-size: 0.75rem;
    color: #666;
  }

  .cart-item__price {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 0.85rem;
    color: #111111;
    margin-top: 0.3rem;
  }

  /* Pill-Shaped Quantity Adjustment Box */
  .cart-item__qty-selector {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #e2e2e2;
    border-radius: 8px;
    padding: 0.25rem 0.5rem;
    width: 76px;
    height: 30px;
    box-sizing: border-box;
    background: #ffffff;
    flex-shrink: 0;
  }

  .cart-item__qty-btn {
    background: none;
    border: none;
    font-family: 'Archivo', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: #333333;
    cursor: pointer;
    padding: 0;
    width: 18px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .cart-item__qty-btn:hover {
    color: #000000;
  }

  .cart-item__qty-val {
    font-family: 'Archivo', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: #111111;
    text-align: center;
  }

  .cart-drawer__footer {
    padding: 1.5rem;
    border-top: 1px solid #eee;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    font-family: 'Archivo', sans-serif;
  }

  .cart-drawer__checkout-btn, .cart-drawer__view-cart-btn {
    display: block;
    text-align: center;
    padding: 0.85rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .cart-drawer__checkout-btn {
    background: #000000;
    color: #ffffff;
  }

  .cart-drawer__view-cart-btn {
    background: #ffffff;
    color: #000000;
    border: 1px solid #000000;
  }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.product-card');
    let wishlist = JSON.parse(localStorage.getItem('shopify_wishlist')) || [];

    cards.forEach(card => {
      const productId = card.dataset.productId;
      const variants = JSON.parse(card.querySelector('.product-variants-json').textContent);
      const colorSwatches = card.querySelectorAll('.color-swatch');
      const sizeBtns = card.querySelectorAll('.size-btn');
      const track = card.querySelector('.product-card__track');
      const slideImgs = card.querySelectorAll('.product-card__slide-img');
      const imageWrapper = card.querySelector('.product-card__image-wrapper');
      const wishlistBtn = card.querySelector('.wishlist-btn');
      const colorLabel = card.querySelector('#SelectedColor-' + productId);

      let selectedColor = colorSwatches.length > 0 ? colorSwatches[0].dataset.color : null;
      let selectedSize = null;
      let currentSlide = 0;
      let isCooldown = false;

      // Wishlist Persistence
      if (wishlistBtn) {
        if (wishlist.includes(productId)) {
          wishlistBtn.classList.add('active');
        }

        wishlistBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          if (wishlist.includes(productId)) {
            wishlist = wishlist.filter(id => id !== productId);
            wishlistBtn.classList.remove('active');
          } else {
            wishlist.push(productId);
            wishlistBtn.classList.add('active');
          }

          localStorage.setItem('shopify_wishlist', JSON.stringify(wishlist));
        });
      }

      // Smooth Touchpad/Wheel Scroll
      if (track && slideImgs.length > 1 && imageWrapper) {
        imageWrapper.addEventListener('wheel', (e) => {
          const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
          if (Math.abs(delta) < 15 || isCooldown) return;
          e.preventDefault();

          if (delta > 0 && currentSlide < slideImgs.length - 1) {
            currentSlide++;
          } else if (delta < 0 && currentSlide > 0) {
            currentSlide--;
          } else {
            return;
          }

          track.style.transform = `translateX(-${currentSlide * 100}%)`;
          isCooldown = true;
          setTimeout(() => { isCooldown = false; }, 220);
        }, { passive: false });
      }

      // Helper function to find matching variant cleanly
      function findVariant(color, size) {
        return variants.find(v => {
          const matchesColor = !color || v.options.map(o => o.toLowerCase()).includes(color.toLowerCase());
          const matchesSize = !size || v.options.map(o => o.toLowerCase()).includes(size.toLowerCase());
          return matchesColor && matchesSize;
        });
      }

      // Update Size Availability based on current color
      function updateSizeAvailability() {
        sizeBtns.forEach(btn => {
          const sizeVal = btn.dataset.size;
          const matchingVariant = findVariant(selectedColor, sizeVal);

          if (!matchingVariant || !matchingVariant.available) {
            btn.classList.add('disabled');
          } else {
            btn.classList.remove('disabled');
          }
        });
      }

      updateSizeAvailability();

      // Swatch Click Logic
      colorSwatches.forEach(swatch => {
        swatch.addEventListener('click', (e) => {
          e.preventDefault();
          colorSwatches.forEach(s => s.classList.remove('active'));
          swatch.classList.add('active');

          selectedColor = swatch.dataset.color;
          if (colorLabel) colorLabel.textContent = selectedColor;

          const newImgSrc = swatch.dataset.variantImg;
          if (newImgSrc && slideImgs.length > 0) {
            slideImgs[0].src = newImgSrc;
            currentSlide = 0;
            if (track) track.style.transform = 'translateX(0%)';
          }

          updateSizeAvailability();
        });
      });

      // Size Click Logic & Add-to-Cart Trigger
      sizeBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          if (btn.classList.contains('disabled')) return;

          sizeBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          selectedSize = btn.dataset.size;

          const matchedVariant = findVariant(selectedColor, selectedSize);

          if (matchedVariant && matchedVariant.available) {
            addToCart(matchedVariant.id);
          } else {
            console.warn('Variant unavailable or not found for:', selectedColor, selectedSize);
          }
        });
      });
    });

    // Add to Cart & Dispatch standard global theme events
    function addToCart(variantId) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(res => res.json())
      .then(cartData => {
        // Dispatch multiple common event formats so standard drawer snippets pick it up
        document.dispatchEvent(new CustomEvent('cart:open', {
          bubbles: true,
          detail: { variantId: variantId, cart: cartData }
        }));

        document.dispatchEvent(new CustomEvent('cart:refresh', {
          bubbles: true,
          detail: { cart: cartData }
        }));

        document.dispatchEvent(new CustomEvent('cart:updated', {
          bubbles: true,
          detail: { cart: cartData }
        }));

        // Dawn theme native drawer trigger support
        if (window.Shopify && Shopify.theme && Shopify.theme.cart) {
          document.querySelector('cart-drawer')?.open();
        }
      })
      .catch(err => console.error('Error adding to cart:', err));
    }
  });
</script>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Signature Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}