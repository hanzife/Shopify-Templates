```liquid
{%- if section.settings.show_section -%}

<section class="instagram-section" id="instagramSection">

    <div class="instagram-header">

        <div class="instagram-heading">
            <h2>{{ section.settings.heading | escape }}</h2>
            <p>{{ section.settings.subheading | escape }}</p>
        </div>

        {%- if section.settings.button_url != blank -%}
            <a
                href="{{ section.settings.button_url }}"
                class="instagram-follow"
                aria-label="Follow us on Instagram"
                target="_blank"
                rel="noopener"
            >
                {{ section.settings.button_text | escape }}
            </a>
        {%- endif -%}

    </div>


    <div class="instagram-carousel">

        <div class="instagram-track">

            <!-- ORIGINAL GROUP -->
            <div class="instagram-group">

                {%- for i in (1..10) -%}

                    <div class="instagram-poster">

                        {%- case i -%}

                            {%- when 1 -%}
                                {%- assign image = section.settings.instagram_1 -%}

                            {%- when 2 -%}
                                {%- assign image = section.settings.instagram_2 -%}

                            {%- when 3 -%}
                                {%- assign image = section.settings.instagram_3 -%}

                            {%- when 4 -%}
                                {%- assign image = section.settings.instagram_4 -%}

                            {%- when 5 -%}
                                {%- assign image = section.settings.instagram_5 -%}

                            {%- when 6 -%}
                                {%- assign image = section.settings.instagram_6 -%}

                            {%- when 7 -%}
                                {%- assign image = section.settings.instagram_7 -%}

                            {%- when 8 -%}
                                {%- assign image = section.settings.instagram_8 -%}

                            {%- when 9 -%}
                                {%- assign image = section.settings.instagram_9 -%}

                            {%- when 10 -%}
                                {%- assign image = section.settings.instagram_10 -%}

                        {%- endcase -%}


                        {%- if image != blank -%}

                            <img
                                src="{{ image | image_url: width: 800 }}"
                                alt="{{ image.alt | escape }}"
                                draggable="false"
                                loading="{% if i <= 3 %}eager{% else %}lazy{% endif %}"
                            >

                        {%- else -%}

                            <img
                                src="{{ 'instagram-post.png' | asset_url }}"
                                alt="Instagram post {{ i }}"
                                draggable="false"
                                loading="{% if i <= 3 %}eager{% else %}lazy{% endif %}"
                            >

                        {%- endif -%}

                        <span class="instagram-meta">
                            Instagram
                        </span>

                    </div>

                {%- endfor -%}

            </div>


            <!-- DUPLICATE GROUP FOR SEAMLESS LOOP -->
            <div
                class="instagram-group"
                aria-hidden="true"
            >

                {%- for i in (1..10) -%}

                    <div class="instagram-poster">

                        {%- case i -%}

                            {%- when 1 -%}
                                {%- assign image = section.settings.instagram_1 -%}

                            {%- when 2 -%}
                                {%- assign image = section.settings.instagram_2 -%}

                            {%- when 3 -%}
                                {%- assign image = section.settings.instagram_3 -%}

                            {%- when 4 -%}
                                {%- assign image = section.settings.instagram_4 -%}

                            {%- when 5 -%}
                                {%- assign image = section.settings.instagram_5 -%}

                            {%- when 6 -%}
                                {%- assign image = section.settings.instagram_6 -%}

                            {%- when 7 -%}
                                {%- assign image = section.settings.instagram_7 -%}

                            {%- when 8 -%}
                                {%- assign image = section.settings.instagram_8 -%}

                            {%- when 9 -%}
                                {%- assign image = section.settings.instagram_9 -%}

                            {%- when 10 -%}
                                {%- assign image = section.settings.instagram_10 -%}

                        {%- endcase -%}


                        {%- if image != blank -%}

                            <img
                                src="{{ image | image_url: width: 800 }}"
                                alt=""
                                draggable="false"
                                loading="lazy"
                            >

                        {%- else -%}

                            <img
                                src="{{ 'instagram-post.png' | asset_url }}"
                                alt=""
                                draggable="false"
                                loading="lazy"
                            >

                        {%- endif -%}

                        <span class="instagram-meta">
                            Instagram
                        </span>

                    </div>

                {%- endfor -%}

            </div>

        </div>

    </div>

</section>


<style>

.instagram-section {
    position: relative;
    width: 100%;
    padding: 60px 0;
    background: #fff;
    color: #000;
    overflow: hidden;
}

.instagram-header {
    width: 100%;
    padding: 0 42px;
    margin-bottom: 32px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 40px;
}

.instagram-heading {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.instagram-heading h2 {
    margin: 0;

    font-family: "Archivo", sans-serif;
    font-size: clamp(28px, 3vw, 46px);
    font-weight: 800;

    line-height: 0.9;
    letter-spacing: -0.045em;

    text-transform: uppercase;
}

.instagram-heading p {
    margin: 0;

    font-family: "Inter", sans-serif;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: -0.01em;

    color: rgba(0, 0, 0, 0.55);
}

.instagram-follow {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 50px;
    padding: 0 24px;

    background: #000;
    color: #fff;

    border: 0;
    border-radius: 12px;

    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 600;

    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;

    transition:
        transform 250ms ease,
        background-color 250ms ease;
}

.instagram-follow:hover {
    transform: translateY(-2px);
    background: #0f6be0;
}

.instagram-carousel {
    width: 100%;
    overflow: hidden;
    display: flex;
    position: relative;
}

.instagram-track {
    display: flex;
    gap: 12px;
    width: max-content;

    animation: instagramInfiniteScroll 40s linear infinite;

    will-change: transform;
}

@keyframes instagramInfiniteScroll {

    from {
        transform: translateX(-50%);
    }

    to {
        transform: translateX(0);
    }

}

.instagram-carousel:hover .instagram-track {
    animation-play-state: paused;
}

.instagram-group {
    display: flex;
    gap: 12px;
    flex: 0 0 auto;
}

.instagram-poster {
    position: relative;

    width: clamp(220px, 18vw, 320px);
    aspect-ratio: 4 / 5;

    border-radius: 18px;
    overflow: hidden;

    flex: 0 0 auto;

    background: #e5e5e5;
}

.instagram-poster img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    user-select: none;
    -webkit-user-drag: none;

    transition:
        transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
}

.instagram-poster:hover img {
    transform: scale(1.035);
}

.instagram-meta {
    position: absolute;

    left: 14px;
    bottom: 14px;

    z-index: 2;

    font-family: "Inter", sans-serif;

    font-size: 9px;
    font-weight: 500;

    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: #fff;

    opacity: 0;

    transform: translateY(5px);

    transition:
        opacity 250ms ease,
        transform 250ms ease;
}

.instagram-poster:hover .instagram-meta {
    opacity: 1;
    transform: translateY(0);
}

@media (max-width: 900px) {

    .instagram-section {
        padding: 40px 0;
    }

    .instagram-header {
        padding: 0 20px;
        margin-bottom: 24px;
        align-items: flex-start;
    }

    .instagram-heading h2 {
        font-size: 30px;
    }

    .instagram-heading p {
        font-size: 12px;
    }

    .instagram-follow {
        height: 38px;
        padding: 0 16px;
        font-size: 10px;
    }

    .instagram-track,
    .instagram-group {
        gap: 8px;
    }

    .instagram-poster {
        width: 160px;
    }

}

</style>

{%- endif -%}


