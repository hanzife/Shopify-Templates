<section class="jacket-section" id="jacketSection">
    <div class="jacket-stage">
        <div class="collection-label">
            {{ section.settings.subheading | default: 'The Jacket Collection' }}
        </div>

        <div class="jacket-copy">
            <h2>{{ section.settings.heading_text | default: 'THE JACKET<br>COLLECTION' }}</h2>
            <p>{{ section.settings.description_text | newline_to_br | default: 'Designed for movement.<br>Built for every moment.' }}</p>
        </div>

        <div class="model-wrap">
            {%- if section.settings.model_image != blank -%}
                <img class="model" src="{{ section.settings.model_image | image_url: width: 1200 }}" alt="Fashion model" loading="lazy">
            {%- else -%}
                <img class="model" src="{{ 'model.png' | asset_url }}" alt="Fashion model" loading="lazy">
            {%- endif -%}
        </div>

        <div class="jacket-viewport" id="jacketViewport">
            <div class="jacket-track" id="jacketTrack">
                {%- assign target_collection = section.settings.collection -%}
                
                {%- if target_collection != blank -%}
                    {%- for product in target_collection.products limit: 5 -%}
                        <div class="jacket-slot" data-product-handle="{{ product.handle }}">
                            <a href="{{ product.url }}">
                                {%- if product.featured_media != blank -%}
                                    <img class="jacket-image" src="{{ product.featured_media | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
                                {%- else -%}
                                    {{ 'product-1' | placeholder_svg_tag: 'jacket-image' }}
                                {%- endif -%}
                            </a>
                        </div>
                    {%- endfor -%}
                {%- else -%}
                    {%- for product in collections['all'].products limit: 5 -%}
                        <div class="jacket-slot" data-product-handle="{{ product.handle }}">
                            <a href="{{ product.url }}">
                                {%- if product.featured_media != blank -%}
                                    <img class="jacket-image" src="{{ product.featured_media | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
                                {%- else -%}
                                    {{ 'product-1' | placeholder_svg_tag: 'jacket-image' }}
                                {%- endif -%}
                            </a>
                        </div>
                    {%- endfor -%}
                {%- endif -%}
            </div>
        </div>

        <div class="jacket-label" id="jacketLabel">
            Jacket 01
        </div>

        <div class="jacket-ui">
            <div class="jacket-counter">
                <span id="currentJacket">01</span>
                &nbsp;/&nbsp;
                <span id="totalJackets">05</span>
            </div>
            <div class="jacket-progress">
                <div class="jacket-progress-bar" id="progressBar"></div>
            </div>
        </div>
    </div>
</section>

<style>
.jacket-section {
    position: relative;
    width: 100%;
    /* height: 500vh; -> REMOVED so JS handles height dynamically */
    background: #fff;
}

.jacket-stage {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #fff;
}

.jacket-copy {
    position: absolute;
    left: 42px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 260px;
    pointer-events: none;
}

.jacket-copy h2 {
    margin: 0 0 18px;
    font-family: "Archivo", sans-serif;
    font-size: clamp(32px, 3.2vw, 52px);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: #000;
}

.jacket-copy p {
    margin: 0;
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: #000;
}

.model-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(35vw, 520px);
    height: 100vh;
    transform: translate(-50%, -50%);
    z-index: 20;
    pointer-events: none;
}

.model {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 90%;
    height: auto;
    transform: translate(-50%, -50%);
    display: block;
}

.jacket-viewport {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(42vw, 620px);
    height: 88vh;
    transform: translate(-50%, -50%);
    z-index: 30;
    pointer-events: none;
    overflow: visible;
}

.jacket-track {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    will-change: transform;
}

.jacket-slot {
    position: relative;
    width: min(42vw, 620px);
    height: 88vh;
    flex: 0 0 min(42vw, 620px);
    display: flex;
    align-items: center;
    justify-content: center;
}

.jacket-slot a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.jacket-image {
    width: 82%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    display: block;
    will-change: transform, opacity, filter;
    user-select: none;
    transition: transform 650ms ease-out, opacity 650ms ease-out, filter 650ms ease-out;
}

.jacket-ui {
    position: absolute;
    left: 50%;
    bottom: 42px;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 18px;
    pointer-events: none;
}

.jacket-counter {
    font-size: 12px;
    letter-spacing: .12em;
    font-weight: 500;
    color: #111;
    white-space: nowrap;
}

.jacket-progress {
    width: 100px;
    height: 1px;
    background: rgba(0, 0, 0, .15);
    position: relative;
    overflow: hidden;
}

.jacket-progress-bar {
    position: absolute;
    left: 0;
    top: 0;
    width: 0%;
    height: 100%;
    background: #111;
}

.jacket-label {
    position: absolute;
    left: 42px;
    bottom: 42px;
    z-index: 100;
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, .55);
    pointer-events: none;
}

.collection-label {
    position: absolute;
    top: 38px;
    left: 42px;
    z-index: 100;
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, .45);
    pointer-events: none;
}

@media (max-width: 900px) {
    .model-wrap { width: 86vw; height: 78vh; }
    .jacket-viewport { width: 72vw; height: 78vh; }
    .jacket-slot { width: 72vw; height: 78vh; flex-basis: 72vw; }
    .jacket-image { width: 88%; max-height: 68vh; }
    .collection-label { left: 20px; top: 22px; }
    .jacket-label { left: 20px; bottom: 24px; }
    .jacket-ui { bottom: 24px; }
}

@media (prefers-reduced-motion: reduce) {
    .jacket-section { height: auto; }
    .jacket-stage { position: relative; height: auto; min-height: 100vh; }
    .jacket-track { position: relative; transform: none !important; }
}
</style>

<!-- Make sure GSAP and ScrollTrigger are loaded in your theme layout (theme.liquid) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
(function () {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector("#jacketSection");
    const track = document.querySelector("#jacketTrack");
    const jackets = gsap.utils.toArray(".jacket-image");
    const currentJacket = document.querySelector("#currentJacket");
    const totalJackets = document.querySelector("#totalJackets");
    const jacketLabel = document.querySelector("#jacketLabel");
    const progressBar = document.querySelector("#progressBar");

    function createJacketExperience() {
        const slots = gsap.utils.toArray(".jacket-slot");
        if (!slots.length) return;

        const COUNT = slots.length;
        
        if (totalJackets) {
            totalJackets.textContent = String(COUNT).padStart(2, "0");
        }

        // Dynamically compute container scroll height precisely based on actual item count
        const scrollDurationMultiplier = Math.max(1, COUNT - 1) * 100;
        section.style.height = `${100 + scrollDurationMultiplier}vh`;

        let currentIndex = 0;
        let isAnimating = false;
        let wheelLocked = false;
        let wheelReleaseTimer = null;

        const TRANSITION_DURATION = 0.9;
        const WHEEL_THRESHOLD = 12;
        const RELEASE_DELAY = 180;

        function getSlotWidth() {
            return slots[0].getBoundingClientRect().width;
        }

        function updateUI(index) {
            const number = String(index + 1).padStart(2, "0");
            if (currentJacket) currentJacket.textContent = number;
            if (jacketLabel) jacketLabel.textContent = `Jacket ${number}`;

            gsap.to(progressBar, {
                width: `${(index / Math.max(1, COUNT - 1)) * 100}%`,
                duration: 0.45,
                ease: "power2.out",
                overwrite: true
            });
        }

        function updateJacketStates(index, animate = true) {
            jackets.forEach((jacket, i) => {
                const active = i === index;
                gsap.to(jacket, {
                    opacity: active ? 1 : 0.18,
                    scale: active ? 1 : 0.94,
                    duration: animate ? 0.65 : 0,
                    ease: "power2.out",
                    overwrite: true
                });
            });
        }

        function positionJacket(index, animate = true) {
            const x = -(getSlotWidth() * index);

            if (!animate) {
                gsap.set(track, { x });
                updateJacketStates(index, false);
                updateUI(index);
                return;
            }

            isAnimating = true;

            gsap.timeline({
                defaults: { overwrite: "auto" },
                onComplete: () => {
                    isAnimating = false;
                    clearTimeout(wheelReleaseTimer);
                    wheelReleaseTimer = setTimeout(() => {
                        wheelLocked = false;
                    }, RELEASE_DELAY);
                }
            })
            .to(track, { x, duration: TRANSITION_DURATION, ease: "power3.inOut" }, 0)
            .to(progressBar, { width: `${(index / Math.max(1, COUNT - 1)) * 100}%`, duration: 0.7, ease: "power2.out" }, 0.1);

            updateJacketStates(index, true);
            currentIndex = index;
            if (currentJacket) currentJacket.textContent = String(index + 1).padStart(2, "0");
            if (jacketLabel) jacketLabel.textContent = `Jacket ${String(index + 1).padStart(2, "0")}`;
        }

        const trigger = ScrollTrigger.create({
            trigger: section,
            start: "top top",
            end: `+=${scrollDurationMultiplier}%`,
            pin: ".jacket-stage",
            pinSpacing: true,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onEnter: () => { if (!isAnimating) positionJacket(0, false); },
            onEnterBack: () => { if (!isAnimating) positionJacket(COUNT - 1, false); }
        });

        function handleWheel(event) {
            if (!trigger.isActive) return;
            const delta = event.deltaY;
            if (Math.abs(delta) < WHEEL_THRESHOLD) return;

            if ((currentIndex === 0 && delta < 0) || (currentIndex === COUNT - 1 && delta > 0)) {
                return;
            }

            event.preventDefault();
            if (isAnimating || wheelLocked) return;
            wheelLocked = true;

            const direction = delta > 0 ? 1 : -1;
            const nextIndex = currentIndex + direction;

            if (nextIndex < 0 || nextIndex >= COUNT) {
                wheelLocked = false;
                return;
            }

            const progress = nextIndex / Math.max(1, COUNT - 1);
            const scrollPosition = trigger.start + (trigger.end - trigger.start) * progress;

            window.scrollTo({ top: scrollPosition, behavior: "instant" });
            positionJacket(nextIndex, true);
        }

        window.addEventListener("wheel", handleWheel, { passive: false });

        window.addEventListener("resize", () => {
            if (isAnimating) return;
            gsap.set(track, { x: -(getSlotWidth() * currentIndex) });
        });

        positionJacket(0, false);
    }

    function entranceAnimation() {
        gsap.fromTo(".model-wrap", { opacity: 0, y: 35 }, {
            opacity: 1, y: 0, duration: 1.2, ease: "power3.out",
            scrollTrigger: { trigger: section, start: "top 85%", once: true }
        });

        gsap.fromTo(".collection-label", { opacity: 0, y: 10 }, {
            opacity: 1, y: 0, duration: 1, delay: .15, ease: "power3.out",
            scrollTrigger: { trigger: section, start: "top 85%", once: true }
        });
    }

    function init() {
        createJacketExperience();
        entranceAnimation();
        ScrollTrigger.refresh();
    }

    const images = document.querySelectorAll(".jacket-image, .model");
    let loaded = 0;

    if (images.length === 0) {
        init();
    } else {
        images.forEach(img => {
            if (img.complete) {
                loaded++;
                if (loaded === images.length) init();
            } else {
                img.addEventListener("load", () => {
                    loaded++;
                    if (loaded === images.length) init();
                }, { once: true });
            }
        });
    }

    let resizeTimer;
    window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => { ScrollTrigger.refresh(); }, 250);
    });
})();
</script>

{% schema %}
{
  "name": "Jacket Collection",
  "class": "velluto-jacket-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading Label",
      "default": "The Jacket Collection"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading (Use <br> for line breaks)",
      "default": "THE JACKET<br>COLLECTION"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description Text",
      "default": "Designed for movement.\nBuilt for every moment."
    },
    {
      "type": "image_picker",
      "id": "model_image",
      "label": "Center Model Image"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Pull Products From Collection"
    }
  ],
  "presets": [
    {
      "name": "Jacket Collection"
    }
  ]
}
{% endschema %}