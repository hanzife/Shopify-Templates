<header class="site-header" id="siteHeader">
    <div class="header-left">
        <a href="{{ routes.root_url }}" class="header-nav-link desktop-only">{{ section.settings.home_text | default: 'Home' }}</a>
        
        <!-- Products Link Trigger -->
        <div class="mega-menu-trigger desktop-only" id="megaMenuTrigger">
            <a href="{{ routes.all_products_collection_url }}" class="header-nav-link">{{ section.settings.products_text | default: 'Products' }}</a>
        </div>
        
        <!-- Mobile Hamburger Trigger -->
        <button type="button" class="header-icon-btn mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle Menu" aria-expanded="false">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    </div>

    <a href="{{ routes.root_url }}" class="header-logo">{{ section.settings.logo_text | default: 'Stich Clothing' }}</a>

    <div class="header-right">
        <a href="{{ routes.cart_url }}" class="header-icon-btn" aria-label="Cart / Bag">
            <svg viewBox="0 0 24 24">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
        </a>
    </div>

    <!-- 100% Full-Width Mega Menu Dropdown -->
    <div class="mega-menu-dropdown" id="megaMenuDropdown">
        <div class="mega-menu-container">
            {% for collection in collections %}
                {% if collection.handle != 'frontpage' %}
                    <div class="mega-menu-column">
                        <a href="{{ collection.url }}" class="mega-menu-parent-title">{{ collection.title }}</a>
                        
                        <ul class="mega-menu-sublist">
                            {% if collection.products.size > 0 %}
                                {% for product in collection.products limit: 6 %}
                                    <li><a href="{{ product.url }}" class="mega-menu-sublink">{{ product.title }}</a></li>
                                {% endfor %}
                            {% else %}
                                <li><span class="mega-menu-sublink empty-notice">No items available</span></li>
                            {% endif %}
                            <li><a href="{{ collection.url }}" class="mega-menu-view-all">View All {{ collection.title }} →</a></li>
                        </ul>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</header>

<!-- Mobile Navigation Drawer Overlay -->
<div class="mobile-nav-drawer" id="mobileNavDrawer" aria-hidden="true">
    <div class="mobile-nav-content">
        <a href="{{ routes.root_url }}" class="mobile-nav-link">{{ section.settings.home_text | default: 'Home' }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="mobile-nav-link">{{ section.settings.products_text | default: 'Products' }}</a>
    </div>
</div>

<style>
/* ==========================================================
   APPLE-STYLE BLURRY GLASS HEADER & MOBILE DRAWER
   ========================================================== */
.site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 70px;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 1000;
    background: transparent;
    transition: background 0.3s ease, backdrop-filter 0.3s ease;
    overflow: visible !important;
    
    color: #ffffff;
    mix-blend-mode: difference;
}

.site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    color: #111111;
    mix-blend-mode: normal;
}

.site-header.is-dark {
    color: #ffffff !important;
}
.site-header.is-scrolled.is-dark {
    background: rgba(17, 17, 17, 0.75);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.header-left, .header-right {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1;
}

.header-right {
    justify-content: flex-end;
}

.mega-menu-trigger {
    display: inline-flex;
    align-items: center;
    height: 70px;
}

.header-nav-link, .header-icon-btn {
    background: none;
    border: none;
    color: inherit;
    font-family: Arial, sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    padding: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
}

.header-nav-link:hover, .header-icon-btn:hover {
    opacity: 0.7;
}

.header-logo {
    flex: 1;
    text-align: center;
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
}

.header-icon-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
}

/* ==========================================================
   FULL-WIDTH SLIDE-DOWN MEGA MENU
   ========================================================== */
.mega-menu-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100vw;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    padding: 32px 0; /* Vertical padding only; horizontal padding handled by container */
    
    transform: translateY(-20px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
    color: #111111;
    mix-blend-mode: normal;
    z-index: 998;
}

.site-header.is-dark .mega-menu-dropdown {
    background: rgba(17, 17, 17, 0.98);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
}

.mega-menu-dropdown.is-active {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

/* Inner Container matches header horizontal padding (40px) */
.mega-menu-container {
    width: 100%;
    padding: 0 40px; /* Aligns content directly with nav bar left/right edges */
    display: flex;
    flex-direction: column;
    gap: 24px;
}

/* Row-based layout for left-to-right text flow */
.mega-menu-column {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
    width: 100%;
}

.mega-menu-parent-title {
    font-family: Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: inherit;
    text-decoration: none;
    padding-bottom: 0;
    border-bottom: none;
    min-width: 140px;
    flex-shrink: 0;
}

/* Sublist flows items horizontally left-to-right */
.mega-menu-sublist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
}

.mega-menu-sublink {
    font-family: Arial, sans-serif;
    font-size: 13px;
    color: rgba(0, 0, 0, 0.65);
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
}

.mega-menu-sublink.empty-notice {
    font-style: italic;
    opacity: 0.5;
}

.site-header.is-dark .mega-menu-sublink {
    color: rgba(255, 255, 255, 0.65);
}

.mega-menu-sublink:hover {
    color: #000000;
}

.site-header.is-dark .mega-menu-sublink:hover {
    color: #ffffff;
}

.mega-menu-view-all {
    display: inline-block;
    margin-top: 0;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s ease;
    white-space: nowrap;
}

.mega-menu-view-all:hover {
    opacity: 1;
}

/* Mobile Hamburger Button Styling */
.mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 28px;
    height: 28px;
    padding: 0;
    z-index: 1002;
}

.hamburger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
}

.mobile-menu-toggle.is-active .hamburger-line:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
}
.mobile-menu-toggle.is-active .hamburger-line:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
}

/* Mobile Fullscreen Glass Drawer */
.mobile-nav-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s ease;
}

.site-header.is-dark ~ .mobile-nav-drawer,
.mobile-nav-drawer.is-dark-drawer {
    background: rgba(17, 17, 17, 0.95);
    color: #ffffff;
}

.mobile-nav-drawer.is-open {
    opacity: 1;
    visibility: visible;
}

.mobile-nav-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    transform: translateY(20px) scale(0.98);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.mobile-nav-drawer.is-open .mobile-nav-content {
    transform: translateY(0) scale(1);
}

.mobile-nav-link {
    font-family: 'Archivo', sans-serif;
    font-size: 28px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    color: #111111;
    letter-spacing: 0.04em;
    transition: opacity 0.2s ease;
}

.mobile-nav-drawer.is-dark-drawer .mobile-nav-link {
    color: #ffffff;
}

.mobile-nav-link:hover {
    opacity: 0.6;
}

@media (max-width: 900px) {
    .site-header {
        padding: 0 20px;
        height: 60px;
    }
    .mega-menu-container {
        padding: 0 20px;
    }
    .mega-menu-dropdown {
        display: none !important;
    }
    .desktop-only {
        display: none !important;
    }
    .mobile-menu-toggle {
        display: inline-flex;
    }
}
</style>

<script>
(function () {
    const header = document.getElementById('siteHeader');
    const mobileToggle = document.getElementById('mobileMenuToggle');
    const mobileDrawer = document.getElementById('mobileNavDrawer');
    const megaTrigger = document.getElementById('megaMenuTrigger');
    const megaDropdown = document.getElementById('megaMenuDropdown');

    if (!header) return;

    window.addEventListener('scroll', () => {
        if (window.scrollY > 40) {
            header.classList.add('is-scrolled');
        } else {
            header.classList.remove('is-scrolled');
        }
    }, { passive: true });

    if (megaTrigger && megaDropdown) {
        let hoverTimer;

        const showMegaMenu = () => {
            clearTimeout(hoverTimer);
            megaDropdown.classList.add('is-active');
        };

        const hideMegaMenu = () => {
            hoverTimer = setTimeout(() => {
                megaDropdown.classList.remove('is-active');
            }, 180);
        };

        megaTrigger.addEventListener('mouseenter', showMegaMenu);
        megaTrigger.addEventListener('mouseleave', hideMegaMenu);
        megaDropdown.addEventListener('mouseenter', showMegaMenu);
        megaDropdown.addEventListener('mouseleave', hideMegaMenu);
    }

    if (mobileToggle && mobileDrawer) {
        mobileToggle.addEventListener('click', () => {
            const isOpen = mobileDrawer.classList.toggle('is-open');
            mobileToggle.classList.toggle('is-active', isOpen);
            mobileToggle.setAttribute('aria-expanded', isOpen);
            mobileDrawer.setAttribute('aria-hidden', !isOpen);
            
            if (header.classList.contains('is-dark')) {
                mobileDrawer.classList.add('is-dark-drawer');
            } else {
                mobileDrawer.classList.remove('is-dark-drawer');
            }

            document.body.style.overflow = isOpen ? 'hidden' : '';
        });
    }

    const darkSections = document.querySelectorAll('.jacket-reveal, [data-theme="dark"], .dark-section');
    
    if (darkSections.length > 0) {
        const observerOptions = {
            root: null,
            rootMargin: '-70px 0px -80% 0px',
            threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    header.classList.add('is-dark');
                    if (mobileDrawer) mobileDrawer.classList.add('is-dark-drawer');
                } else {
                    header.classList.remove('is-dark');
                    if (mobileDrawer) mobileDrawer.classList.remove('is-dark-drawer');
                }
            });
        }, observerOptions);

        darkSections.forEach(section => observer.observe(section));
    }
})();
</script>

{% schema %}
{
  "name": "Navigation Bar",
  "class": "site-header-section",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "ROVETZA"
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Home Link Text",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "products_text",
      "label": "Products Link Text",
      "default": "Products"
    }
  ],
  "presets": [
    {
      "name": "Navigation Bar"
    }
  ]
}
{% endschema %}