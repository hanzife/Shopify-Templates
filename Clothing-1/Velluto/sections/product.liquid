<style>
:root {
  --ink: #111111;
  --bone: #ffffff;
  --bone-dim: #f9f9f9;
  --copper: #8A4E2B;
  --copper-deep: #5E3319;
  --line: rgba(17, 17, 17, 0.1);
  color-scheme: light;
}

[data-product-section] * { box-sizing: border-box; }

[data-product-section] {
  font-family: 'Source Serif 4', Georgia, serif;
  color: var(--ink);
}

[data-product-section] h1,
[data-product-section] h2,
[data-product-section] h3 {
  font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
  letter-spacing: -0.01em;
  margin: 0;
}

[data-product-section] button:focus-visible,
[data-product-section] a:focus-visible {
  outline: 2px solid var(--copper);
  outline-offset: 3px;
}

/* ---------- HERO SECTION ---------- */
.hero-section {
  position: relative;
  height: 100vh;
  width: 100%;
  display: flex;
  overflow: hidden;
  background: var(--bone);
}

.hero-left {
  width: 30%;
  min-width: 280px;
  padding: 8vh 3vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2.4rem;
  position: relative;
  z-index: 2;
}

.hero-left .kicker {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 0.8rem;
  color: var(--copper-deep);
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.hero-left h1 {
  font-weight: 900;
  font-size: clamp(2.1rem, 3.2vw + 1rem, 3.6rem);
  line-height: 1.02;
  max-width: 16ch;
}

.hero-desc {
  font-size: 1.05rem;
  line-height: 1.65;
  max-width: 34ch;
  color: rgba(17, 17, 17, 0.82);
}

.hero-desc p { margin: 0 0 0.8em; }

.signoff {
  font-size: 0.92rem;
  font-style: italic;
  color: rgba(17, 17, 17, 0.6);
  border-top: 1px solid var(--line);
  padding-top: 1.2rem;
  max-width: 30ch;
}

.hero-center {
  width: 40%;
  height: 100vh;
  position: relative;
  overflow-y: auto;
  scroll-snap-type: y mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  border-left: 1px solid var(--line);
  border-right: 1px solid var(--line);
  background: #f4f4f4;
}
.hero-center::-webkit-scrollbar { display: none; }

.image-track { position: relative; width: 100%; }

.frame {
  height: 100vh;
  width: 100%;
  scroll-snap-align: start;
  scroll-snap-stop: always;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #f4f4f4;
}

.frame img {
  width: 75%;
  height: 70vh;
  object-fit: contain;
  display: block;
  user-select: none;
}

.progress-rail {
  position: absolute;
  top: 0;
  right: 10px;
  height: 100%;
  width: 2px;
  background: var(--line);
  z-index: 3;
  pointer-events: none;
}

.progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: var(--copper);
  transform-origin: top;
}

.hero-right {
  width: 30%;
  min-width: 280px;
  padding: 8vh 3vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1.6rem;
  position: relative;
  z-index: 2;
}

.product-heading .name {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
}

.product-heading .variant {
  font-size: 0.95rem;
  color: rgba(17, 17, 17, 0.6);
  margin-top: 0.3rem;
}

.price {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1.6rem;
}

.price-compare {
  font-family: 'Archivo', sans-serif;
  font-weight: 500;
  font-size: 1rem;
  color: rgba(17, 17, 17, 0.45);
  margin-left: 0.5rem;
}

.field-label {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 0.85rem;
  margin-bottom: 0.7rem;
  display: block;
}

.option-block + .option-block { margin-top: 1.2rem; }

.size-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  width: 100%;
  margin-bottom: 20px;
}

.size-btn {
  flex: 1;
  min-width: 46px;
  height: 46px;
  border-radius: 8px;
  border: 1px solid rgba(21, 18, 14, 0.2);
  background: transparent;
  color: var(--ink);
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 0.9rem;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.size-btn:hover { background: rgba(21, 18, 14, 0.06); }

.size-btn.active {
  background: var(--ink);
  color: var(--bone);
  border-color: var(--ink);
}

.qty-row {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid var(--ink);
  border-radius: 8px;
  overflow: hidden;
  width: fit-content;
}

.qty-row button {
  width: 40px;
  height: 42px;
  background: transparent;
  border: none;
  font-size: 1.1rem;
  color: var(--ink);
  cursor: pointer;
  font-family: inherit;
}
.qty-row button:hover { background: rgba(17, 17, 17, 0.06); }

.qty-row .qty-value {
  width: 46px;
  text-align: center;
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  border: none;
  background: transparent;
  -moz-appearance: textfield;
}
.qty-row .qty-value::-webkit-outer-spin-button,
.qty-row .qty-value::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.add-to-cart {
  margin-top: 20xpx;
  background: var(--ink);
  color: var(--bone);
  border: none;
  border-radius: 12px;
  padding: 1rem 1.4rem;
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1rem;
  cursor: pointer;
  transition: transform 0.12s ease, background 0.15s ease, opacity 0.15s ease;
  width: 100%;
}
.add-to-cart:hover { background: #333; }
.add-to-cart:active { transform: scale(0.98); }
.add-to-cart:disabled {
  background: rgba(17, 17, 17, 0.3);
  cursor: not-allowed;
  transform: none;
}

.add-note {
  font-size: 0.82rem;
  color: rgba(17, 17, 17, 0.55);
  min-height: 1.2em;
}

/* ---------- RESPONSIVE ---------- */
@media (max-width: 900px) {
  .hero-section { flex-direction: column; height: auto; }
  .hero-left { height: auto; padding: 4vh 6vw; gap: 1.2rem; }
  .hero-desc, .signoff { display: none; }
  .hero-center {
    height: 50vh;
    width: 100%;
    border-left: none;
    border-right: none;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .hero-right { height: auto; padding: 2.5vh 6vw; gap: 0.8rem; }
}
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&display=swap"
  rel="stylesheet">

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- liquid
  assign display_category = section.settings.kicker
  if display_category == blank
    if product.metafields.custom.category != blank
      assign display_category = product.metafields.custom.category
    else
      assign display_category = product.type
    endif
  endif

  # Pulling sizes from Shopify's Category Metafields list
  assign product_sizes = product.metafields.shopify.size.value | default: product.metafields.custom.size.value
-%}

<section class="hero-section" data-product-section
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}">

  <div class="hero-left">
    {%- if display_category != blank -%}
      <span class="kicker">{{ display_category }}</span>
    {%- endif -%}
    <h1>{{ product.title | upcase }}</h1>
    <div class="hero-desc">{{ product.description }}</div>
    <p class="signoff">{{ section.settings.signoff | default: "Made in Fife. One jacket, cut to outlast the person wearing it." }}</p>
  </div>

  <div class="hero-center" id="heroCenter">
    <div class="image-track" id="imageTrack">
      {%- for image in product.images -%}
        <div class="frame">
          <img
            src="{{ image | image_url: width: 1200 }}"
            srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1200 }} 1200w"
            sizes="40vw"
            alt="{{ image.alt | default: product.title | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            draggable="false"
            width="{{ image.width }}"
            height="{{ image.height }}">
        </div>
      {%- else -%}
        <div class="frame">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endfor -%}
    </div>
    <div class="progress-rail">
      <div class="progress-fill" id="progressFill"></div>
    </div>
  </div>

  <div class="hero-right">
    <div class="product-heading">
      <div class="name">{{ product.title }}</div>
      {%- if current_variant.title != 'Default Title' -%}
        <div class="variant" id="variantLabel">{{ current_variant.title }}</div>
      {%- endif -%}
    </div>

    <div class="price" id="priceValue">
      {{ current_variant.price | money }}
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <s class="price-compare">{{ current_variant.compare_at_price | money }}</s>
      {%- endif -%}
    </div>

    <form method="post" action="/cart/add" id="productForm" data-product-form>
      <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}">

      {%- if product_sizes != blank -%}
        <div class="option-block">
          <span class="field-label">Size</span>
          <div class="size-row" id="sizeRow">
            {%- for size_entry in product_sizes -%}
              {%- liquid
                # Resolve the metaobject reference safely
                assign resolved_obj = size_entry | metaobject
                assign size_label = resolved_obj.name.value | default: resolved_obj.label.value | default: resolved_obj.title.value | default: size_entry.name.value | default: size_entry.value | default: size_entry
              -%}
              {%- if size_label != blank and size_label != 'MetaobjectDrop' -%}
                <button
                  type="button"
                  class="size-btn{% if forloop.first %} active{% endif %}"
                  data-size="{{ size_label | escape }}">
                  {{ size_label }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div>
        <span class="field-label">Quantity</span>
        <div class="qty-row">
          <button type="button" id="qtyMinus" aria-label="Decrease quantity">&minus;</button>
          <input type="number" name="quantity" id="qtyValue" class="qty-value" value="1" min="1" inputmode="numeric">
          <button type="button" id="qtyPlus" aria-label="Increase quantity">+</button>
        </div>
      </div>

      <button type="submit" class="add-to-cart" id="addToCart"
        {% unless current_variant.available %}disabled{% endunless %}>
        <span class="btn-label">
          {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </span>
      </button>
      <div class="add-note" id="addNote" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<script>
  (function () {
    var heroCenter = document.getElementById('heroCenter');
    var fill = document.getElementById('progressFill');
    if (heroCenter && fill) {
      function updateProgress() {
        var maxScroll = heroCenter.scrollHeight - heroCenter.clientHeight;
        var progress = maxScroll > 0 ? heroCenter.scrollTop / maxScroll : 0;
        fill.style.height = (progress * 100) + '%';
      }
      heroCenter.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
    }

    var section = document.querySelector('[data-product-section]');
    if (!section) return;

    var productJsonEl = document.getElementById('productJson-{{ section.id }}');
    var productData = productJsonEl ? JSON.parse(productJsonEl.textContent) : null;
    var form = section.querySelector('[data-product-form]');
    var variantIdInput = document.getElementById('variantId');
    var addBtn = document.getElementById('addToCart');
    var addNote = document.getElementById('addNote');

    var sizeButtons = section.querySelectorAll('.size-btn');
    sizeButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        sizeButtons.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
      });
    });

    var qtyInput = document.getElementById('qtyValue');
    document.getElementById('qtyMinus').addEventListener('click', function () {
      qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
    });
    document.getElementById('qtyPlus').addEventListener('click', function () {
      qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (addBtn.disabled) return;

      addBtn.disabled = true;
      var originalLabel = addBtn.querySelector('.btn-label').textContent;
      addBtn.querySelector('.btn-label').textContent = 'Adding…';
      addNote.textContent = '';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          id: variantIdInput.value,
          quantity: parseInt(qtyInput.value, 10) || 1
        })
      })
        .then(function (res) {
          if (!res.ok) return res.json().then(function (err) { throw err; });
          return res.json();
        })
        .then(function (item) {
          addNote.textContent = 'Added ' + item.quantity + ' item(s) to your cart.';
          return fetch('/cart.js').then(function (r) { return r.json(); });
        })
        .then(function (cart) {
          document.documentElement.dispatchEvent(
            new CustomEvent('cart:updated', { detail: { cart: cart }, bubbles: true })
          );
          var cartCountEls = document.querySelectorAll('[data-cart-count]');
          cartCountEls.forEach(function (el) { el.textContent = cart.item_count; });
        })
        .catch(function (err) {
          addNote.textContent = (err && err.description) || 'Could not add this item to your cart.';
        })
        .finally(function () {
          addBtn.disabled = false;
          addBtn.querySelector('.btn-label').textContent = originalLabel;
        });
    });
  })();
</script>

{%- assign product_json_id = 'productJson-' | append: section.id -%}
{{ product | json | script_tag: id: product_json_id }}

{% schema %}
{
  "name": "Fieldwork product page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker text (defaults to product category)" },
    { "type": "textarea", "id": "signoff", "label": "Sign-off line", "default": "Made in Fife. One jacket, cut to outlast the person wearing it." }
  ],
  "presets": [
    { "name": "Fieldwork product page" }
  ]
}
{% endschema %}