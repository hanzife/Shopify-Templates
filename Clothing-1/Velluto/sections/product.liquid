<style>
:root {
  --ink: #111111;
  --bone: #ffffff;
  --bone-dim: #f9f9f9;
  --copper: #8A4E2B;
  --copper-deep: #5E3319;
  --line: rgba(17, 17, 17, 0.1);
  color-scheme: light;
}

[data-product-section] * { box-sizing: border-box; }

[data-product-section] {
  font-family: 'Source Serif 4', Georgia, serif;
  color: var(--ink);
  width: 100%;
  background: var(--bone);
}

[data-product-section] h1,
[data-product-section] h2,
[data-product-section] h3 {
  font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
  letter-spacing: -0.01em;
  margin: 0;
}

[data-product-section] button:focus-visible,
[data-product-section] a:focus-visible {
  outline: 2px solid var(--copper);
  outline-offset: 3px;
}

/* ---------- HERO SECTION ---------- */
.hero-section {
  position: relative;
  height: 100vh;
  min-height: 700px;
  width: 100%;
  max-width: 1600px; /* Keeps layout clean on 16" laptops & ultra-wides */
  margin: 0 auto;
  display: flex;
  overflow: hidden;
  background: var(--bone);
}

@supports (height: 100dvh) {
  .hero-section { height: 100dvh; }
}

.hero-left {
  width: 30%;
  min-width: 280px;
  padding: 8vh 3vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2.4rem;
  position: relative;
  z-index: 2;
}

.hero-left .kicker {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 0.8rem;
  color: var(--copper-deep);
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.hero-left h1 {
  font-weight: 900;
  font-size: clamp(2.1rem, 3.2vw + 1rem, 3.6rem);
  line-height: 1.02;
  max-width: 16ch;
}

.hero-desc {
  font-size: 1.05rem;
  line-height: 1.65;
  max-width: 34ch;
  color: rgba(17, 17, 17, 0.82);
}

.hero-desc p { margin: 0 0 0.8em; }

.signoff {
  font-size: 0.92rem;
  font-style: italic;
  color: rgba(17, 17, 17, 0.6);
  border-top: 1px solid var(--line);
  padding-top: 1.2rem;
  max-width: 30ch;
}

.hero-center {
  width: 40%;
  height: 100vh;
  position: relative;
  overflow-y: auto;
  scroll-snap-type: y mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-y: contain;
  border-left: 1px solid var(--line);
  border-right: 1px solid var(--line);
  background: #f4f4f4;
}
.hero-center::-webkit-scrollbar { display: none; }

@supports (height: 100dvh) {
  .hero-center { height: 100dvh; }
}

.image-track { position: relative; width: 100%; }

.frame {
  height: 100vh;
  width: 100%;
  scroll-snap-align: start;
  scroll-snap-stop: always;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #f4f4f4;
}

@supports (height: 100dvh) {
  .frame { height: 100dvh; }
}

.frame img {
  width: 75%;
  height: 70vh;
  object-fit: contain;
  display: block;
  user-select: none;
}

.progress-rail {
  position: absolute;
  top: 0;
  right: 10px;
  height: 100%;
  width: 2px;
  background: var(--line);
  z-index: 3;
  pointer-events: none;
}

.progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: var(--copper);
  transform-origin: top;
}

.hero-right {
  width: 30%;
  min-width: 280px;
  padding: 8vh 3vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 2;
  gap: 20px;
}

.product-heading .name {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1.5rem;
}

.product-heading .variant {
  font-size: 0.95rem;
  color: rgba(17, 17, 17, 0.6);
  margin-top: 0.3rem;
}

.price {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1.6rem;
}

.price-compare {
  font-family: 'Archivo', sans-serif;
  font-weight: 500;
  font-size: 1rem;
  color: rgba(17, 17, 17, 0.45);
  margin-left: 0.5rem;
}

.field-label {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 0.85rem;
  margin-bottom: 0.7rem;
  display: block;
}

.option-block + .option-block { margin-top: 1.2rem; }

.size-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  width: 100%;
  margin-bottom: 20px;
}

.size-btn {
  flex: 1;
  min-width: 46px;
  height: 46px;
  border-radius: 8px;
  border: 1px solid rgba(21, 18, 14, 0.2);
  background: transparent;
  color: var(--ink);
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 0.9rem;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.size-btn:hover { background: rgba(21, 18, 14, 0.06); }

.size-btn.active {
  background: var(--ink);
  color: var(--bone);
  border-color: var(--ink);
}

.qty-row {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid var(--ink);
  border-radius: 8px;
  overflow: hidden;
  width: fit-content;
}

.qty-row button {
  width: 40px;
  height: 42px;
  background: transparent;
  border: none;
  font-size: 1.1rem;
  color: var(--ink);
  cursor: pointer;
  font-family: inherit;
}
.qty-row button:hover { background: rgba(17, 17, 17, 0.06); }

.qty-row .qty-value {
  width: 46px;
  text-align: center;
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  border: none;
  background: transparent;
  -moz-appearance: textfield;
}
.qty-row .qty-value::-webkit-outer-spin-button,
.qty-row .qty-value::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.add-to-cart {
  margin-top: 0.6rem;
  background: var(--ink);
  color: var(--bone);
  border: none;
  border-radius: 12px;
  padding: 1rem 1.4rem;
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1rem;
  cursor: pointer;
  transition: transform 0.12s ease, background 0.15s ease, opacity 0.15s ease;
  width: 100%;
}
.add-to-cart:hover { background: #333; }
.add-to-cart:active { transform: scale(0.98); }
.add-to-cart:disabled {
  background: rgba(17, 17, 17, 0.3);
  cursor: not-allowed;
  transform: none;
}

#productForm {
  display: flex;
  flex-direction: column;
  row-gap: 20px;
}

.add-note {
  font-size: 0.82rem;
  color: rgba(17, 17, 17, 0.55);
  min-height: 1.2em;
}

/* ---------- RESPONSIVE ---------- */

/* Tablet / small laptop: same 3-column layout, tighter type */
@media (max-width: 1024px) {
  .hero-left h1 { font-size: clamp(2rem, 2.5vw + 1rem, 3rem); }
}

/* Mobile: single column. We keep the exact same markup — .hero-left,
   .hero-right and #productForm are simply "unwrapped" with display:contents
   so their children can be individually reordered as direct flex items of
   .hero-section. No duplicated content, no JS/Liquid changes. */
@media (max-width: 900px) {
  .hero-section {
    display: flex;
    flex-direction: column;
    height: auto;
    min-height: auto;
    max-width: 100%;
  }

  .hero-left,
  .hero-right,
  #productForm {
    display: contents;
  }

  .hero-left .kicker {
    order: 1;
    padding: 7vw 6vw 0;
  }

  .hero-left h1 {
    order: 2;
    max-width: 100%;
    padding: 0 6vw;
    font-size: clamp(1.9rem, 7vw, 2.6rem);
  }

  .hero-center {
    order: 3;
    width: 100%;
    height: 55vh;
    min-height: 380px;
    max-height: 60vh;
    margin-top: 5vw;
    border-left: none;
    border-right: none;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  @supports (height: 100dvh) {
    .hero-center { height: 55dvh; max-height: 60dvh; }
  }

  .frame {
    height: 55vh;
    min-height: 380px;
  }

  @supports (height: 100dvh) {
    .frame { height: 55dvh; }
  }

  .frame img {
    width: 85%;
    height: 48vh;
  }

  .progress-rail { display: none; }

  .hero-right .product-heading {
    order: 4;
    padding: 6vw 6vw 0;
  }

  .hero-right .price {
    order: 5;
    padding: 0 6vw;
  }

  #productForm input[type="hidden"] { order: 0; }

  .option-block {
    order: 6;
    padding: 4vw 6vw 0;
  }

  /* Quantity sits right after size on mobile */
  .qty-block {
    order: 7;
    padding: 0 6vw;
  }

  /* Description + sign-off, hidden on mobile before, now shown
     directly after quantity as requested */
  .hero-desc {
    order: 8;
    display: block;
    max-width: 100%;
    padding: 6vw 6vw 0;
    font-size: 0.98rem;
  }

  .signoff {
    order: 9;
    display: block;
    max-width: 100%;
    padding: 4vw 6vw 6vw;
    margin-top: 1rem;
  }

  .add-to-cart {
    order: 10;
    margin: 2vw 6vw 0;
    width: calc(100% - 12vw);
  }

  .add-note {
    order: 11;
    padding: 2vw 6vw 8vw;
  }
}

/* Small phones: tighten type and controls further */
@media (max-width: 480px) {
  .hero-left h1 { font-size: 1.7rem; }
  .price { font-size: 1.3rem; }
  .size-btn { min-width: 40px; height: 42px; font-size: 0.82rem; }
  .add-to-cart { padding: 0.9rem 1.2rem; }
  .frame img { width: 90%; height: 44vh; }
}

/* ---------- CART DRAWER ---------- */
.fw-cart-drawer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 17, 17, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
  z-index: 9998;
}
.fw-cart-drawer-overlay.is-open { opacity: 1; pointer-events: auto; }

.fw-cart-drawer-panel {
  position: fixed;
  top: 0;
  right: 0;
  height: 100%;
  width: min(420px, 100vw);
  background: var(--bone);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: -12px 0 32px rgba(0, 0, 0, 0.18);
  font-family: 'Source Serif 4', Georgia, serif;
  color: var(--ink);
}
@supports (height: 100dvh) {
  .fw-cart-drawer-panel { height: 100dvh; }
}
.fw-cart-drawer-panel.is-open { transform: translateX(0); }

.fw-cart-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.4rem 1.4rem 1rem;
  border-bottom: 1px solid var(--line);
  flex-shrink: 0;
}
.fw-cart-drawer-title {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1.15rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
}
.fw-cart-drawer-count {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--bone);
  background: var(--copper);
  border-radius: 999px;
  min-width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 6px;
}
.fw-cart-drawer-close {
  background: none;
  border: none;
  font-size: 1.7rem;
  line-height: 1;
  cursor: pointer;
  color: var(--ink);
  padding: 4px 8px;
  font-family: 'Archivo', sans-serif;
}
.fw-cart-drawer-close:hover { color: var(--copper-deep); }

.fw-cart-drawer-items {
  flex: 1;
  overflow-y: auto;
  padding: 1rem 1.4rem;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  -webkit-overflow-scrolling: touch;
}
.fw-cart-drawer-empty {
  color: rgba(17, 17, 17, 0.55);
  font-size: 0.95rem;
  padding: 2.5rem 0;
  text-align: center;
  margin: 0;
}

.fw-cart-drawer-item {
  display: grid;
  grid-template-columns: 64px 1fr auto;
  gap: 0.9rem;
  align-items: flex-start;
}
.fw-cart-drawer-item-img {
  width: 64px;
  height: 76px;
  background: var(--bone-dim);
  border-radius: 6px;
  overflow: hidden;
  flex-shrink: 0;
}
.fw-cart-drawer-item-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.fw-cart-drawer-item-title {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 0.92rem;
  line-height: 1.3;
}
.fw-cart-drawer-item-variant {
  font-size: 0.82rem;
  color: rgba(17, 17, 17, 0.55);
  margin-top: 0.2rem;
}
.fw-cart-drawer-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.5rem;
  font-size: 0.88rem;
}
.fw-cart-drawer-item-qty { color: rgba(17, 17, 17, 0.6); }
.fw-cart-drawer-item-price {
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
}
.fw-cart-drawer-item-remove {
  background: none;
  border: none;
  font-size: 1.3rem;
  line-height: 1;
  color: rgba(17, 17, 17, 0.4);
  cursor: pointer;
  padding: 2px 4px;
}
.fw-cart-drawer-item-remove:hover { color: var(--copper-deep); }

.fw-cart-drawer-footer {
  padding: 1.2rem 1.4rem 1.6rem;
  border-top: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  flex-shrink: 0;
}
.fw-cart-drawer-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  margin-bottom: 0.3rem;
}

.fw-cart-drawer-btn {
  display: block;
  text-align: center;
  width: 100%;
  padding: 1rem 1.2rem;
  border-radius: 12px;
  font-family: 'Archivo', sans-serif;
  font-weight: 700;
  font-size: 1rem;
  text-decoration: none;
  transition: background 0.15s ease, color 0.15s ease, transform 0.12s ease;
  cursor: pointer;
}
.fw-cart-drawer-btn:active { transform: scale(0.98); }

.fw-cart-drawer-btn--outline {
  background: transparent;
  color: var(--ink);
  border: 1.5px solid var(--ink);
}
.fw-cart-drawer-btn--outline:hover { background: rgba(17, 17, 17, 0.06); }

.fw-cart-drawer-btn--solid {
  background: var(--ink);
  color: var(--bone);
  border: 1.5px solid var(--ink);
}
.fw-cart-drawer-btn--solid:hover { background: #333; }

@media (max-width: 480px) {
  .fw-cart-drawer-panel { width: 100vw; }
}
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&display=swap"
  rel="stylesheet">

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- liquid
  assign display_category = section.settings.kicker
  if display_category == blank
    if product.metafields.custom.category != blank
      assign display_category = product.metafields.custom.category
    else
      assign display_category = product.type
    endif
  endif

  assign product_sizes = product.metafields.shopify.size.value | default: product.metafields.custom.size.value
-%}

<section class="hero-section" data-product-section
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}">

  <div class="hero-left">
    {%- if display_category != blank -%}
      <span class="kicker">{{ display_category }}</span>
    {%- endif -%}
    <h1>{{ product.title | upcase }}</h1>
    <div class="hero-desc">{{ product.description }}</div>
    <p class="signoff">{{ section.settings.signoff | default: "Made in Fife. One jacket, cut to outlast the person wearing it." }}</p>
  </div>

  <div class="hero-center" id="heroCenter">
    <div class="image-track" id="imageTrack">
      {%- for image in product.images -%}
        <div class="frame">
          <img
            src="{{ image | image_url: width: 1200 }}"
            srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 900px) 100vw, 40vw"
            alt="{{ image.alt | default: product.title | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            draggable="false"
            width="{{ image.width }}"
            height="{{ image.height }}">
        </div>
      {%- else -%}
        <div class="frame">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endfor -%}
    </div>
    <div class="progress-rail">
      <div class="progress-fill" id="progressFill"></div>
    </div>
  </div>

  <div class="hero-right">
    <div class="product-heading">
      <div class="name">{{ product.title }}</div>
      {%- if current_variant.title != 'Default Title' -%}
        <div class="variant" id="variantLabel">{{ current_variant.title }}</div>
      {%- endif -%}
    </div>

    <div class="price" id="priceValue">
      {{ current_variant.price | money }}
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <s class="price-compare">{{ current_variant.compare_at_price | money }}</s>
      {%- endif -%}
    </div>

    <form method="post" action="/cart/add" id="productForm" data-product-form>
      <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}">

      {%- if product_sizes != blank -%}
        <div class="option-block">
          <span class="field-label">Size</span>
          <div class="size-row" id="sizeRow">
            {%- for size_entry in product_sizes -%}
              {%- liquid
                assign resolved_obj = size_entry | metaobject
                assign size_label = resolved_obj.name.value | default: resolved_obj.label.value | default: resolved_obj.title.value | default: size_entry.name.value | default: size_entry.value | default: size_entry
              -%}
              {%- if size_label != blank and size_label != 'MetaobjectDrop' -%}
                <button
                  type="button"
                  class="size-btn{% if forloop.first %} active{% endif %}"
                  data-size="{{ size_label | escape }}">
                  {{ size_label }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="qty-block">
        <span class="field-label">Quantity</span>
        <div class="qty-row">
          <button type="button" id="qtyMinus" aria-label="Decrease quantity">&minus;</button>
          <input type="number" name="quantity" id="qtyValue" class="qty-value" value="1" min="1" inputmode="numeric">
          <button type="button" id="qtyPlus" aria-label="Increase quantity">+</button>
        </div>
      </div>

      <button type="submit" class="add-to-cart" id="addToCart"
        {% unless current_variant.available %}disabled{% endunless %}>
        <span class="btn-label">
          {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </span>
      </button>
      <div class="add-note" id="addNote" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<div class="fw-cart-drawer-overlay" id="fwCartDrawerOverlay" data-cart-drawer-overlay></div>
<aside class="fw-cart-drawer-panel" id="fwCartDrawerPanel" role="dialog" aria-modal="true" aria-label="Cart" aria-hidden="true">
  <div class="fw-cart-drawer-header">
    <h2 class="fw-cart-drawer-title">Your cart <span class="fw-cart-drawer-count" id="fwCartDrawerCount">0</span></h2>
    <button type="button" class="fw-cart-drawer-close" id="fwCartDrawerClose" aria-label="Close cart">&times;</button>
  </div>
  <div class="fw-cart-drawer-items" id="fwCartDrawerItems">
    <p class="fw-cart-drawer-empty">Your cart is empty.</p>
  </div>
  <div class="fw-cart-drawer-footer">
    <div class="fw-cart-drawer-total-row">
      <span>Total</span>
      <span id="fwCartDrawerTotal">{{ 0 | money }}</span>
    </div>
    <a href="{{ routes.cart_url }}" class="fw-cart-drawer-btn fw-cart-drawer-btn--outline" id="fwCartDrawerViewCart">View cart</a>
    <a href="/checkout" class="fw-cart-drawer-btn fw-cart-drawer-btn--solid" id="fwCartDrawerCheckout">Checkout</a>
  </div>
</aside>

<script>
  (function () {
    var heroCenter = document.getElementById('heroCenter');
    var fill = document.getElementById('progressFill');
    if (heroCenter && fill) {
      function updateProgress() {
        var maxScroll = heroCenter.scrollHeight - heroCenter.clientHeight;
        var progress = maxScroll > 0 ? heroCenter.scrollTop / maxScroll : 0;
        fill.style.height = (progress * 100) + '%';
      }
      heroCenter.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
    }

    var section = document.querySelector('[data-product-section]');
    if (!section) return;

    /* ---------- Cart drawer ---------- */
    var drawerOverlay = document.getElementById('fwCartDrawerOverlay');
    var drawerPanel = document.getElementById('fwCartDrawerPanel');
    var drawerItemsEl = document.getElementById('fwCartDrawerItems');
    var drawerTotalEl = document.getElementById('fwCartDrawerTotal');
    var drawerCountEl = document.getElementById('fwCartDrawerCount');
    var drawerCloseBtn = document.getElementById('fwCartDrawerClose');

    function fwFormatMoney(cents, currency) {
      var amount = (cents || 0) / 100;
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency || 'USD' }).format(amount);
      } catch (e) {
        return '$' + amount.toFixed(2);
      }
    }

    function fwCartImage(src) {
      if (!src) return '';
      return src.indexOf('//') === 0 ? 'https:' + src : src;
    }

    function fwEscapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function fwRenderDrawer(cart) {
      if (!drawerItemsEl) return;

      if (!cart.items || !cart.items.length) {
        drawerItemsEl.innerHTML = '<p class="fw-cart-drawer-empty">Your cart is empty.</p>';
      } else {
        drawerItemsEl.innerHTML = cart.items.map(function (item) {
          return (
            '<div class="fw-cart-drawer-item" data-key="' + item.key + '">' +
              '<div class="fw-cart-drawer-item-img">' +
                (item.image ? '<img src="' + fwCartImage(item.image) + '" alt="' + fwEscapeHtml(item.product_title) + '" loading="lazy">' : '') +
              '</div>' +
              '<div class="fw-cart-drawer-item-info">' +
                '<div class="fw-cart-drawer-item-title">' + fwEscapeHtml(item.product_title) + '</div>' +
                (item.variant_title ? '<div class="fw-cart-drawer-item-variant">' + fwEscapeHtml(item.variant_title) + '</div>' : '') +
                '<div class="fw-cart-drawer-item-row">' +
                  '<span class="fw-cart-drawer-item-qty">Qty ' + item.quantity + '</span>' +
                  '<span class="fw-cart-drawer-item-price">' + fwFormatMoney(item.line_price, cart.currency) + '</span>' +
                '</div>' +
              '</div>' +
              '<button type="button" class="fw-cart-drawer-item-remove" data-key="' + item.key + '" aria-label="Remove ' + fwEscapeHtml(item.product_title) + '">&times;</button>' +
            '</div>'
          );
        }).join('');
      }

      if (drawerTotalEl) drawerTotalEl.textContent = fwFormatMoney(cart.total_price, cart.currency);
      if (drawerCountEl) drawerCountEl.textContent = cart.item_count;
    }

    function fwOpenDrawer() {
      if (!drawerOverlay || !drawerPanel) return;
      drawerOverlay.classList.add('is-open');
      drawerPanel.classList.add('is-open');
      drawerPanel.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function fwCloseDrawer() {
      if (!drawerOverlay || !drawerPanel) return;
      drawerOverlay.classList.remove('is-open');
      drawerPanel.classList.remove('is-open');
      drawerPanel.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', fwCloseDrawer);
    if (drawerOverlay) drawerOverlay.addEventListener('click', fwCloseDrawer);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawerPanel && drawerPanel.classList.contains('is-open')) {
        fwCloseDrawer();
      }
    });

    if (drawerItemsEl) {
      drawerItemsEl.addEventListener('click', function (e) {
        var btn = e.target.closest ? e.target.closest('.fw-cart-drawer-item-remove') : null;
        if (!btn) return;
        var key = btn.getAttribute('data-key');
        btn.disabled = true;

        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: key, quantity: 0 })
        })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            fwRenderDrawer(cart);
            document.documentElement.dispatchEvent(
              new CustomEvent('cart:updated', { detail: { cart: cart }, bubbles: true })
            );
            document.querySelectorAll('[data-cart-count]').forEach(function (el) {
              el.textContent = cart.item_count;
            });
          })
          .catch(function () {
            btn.disabled = false;
          });
      });
    }

    /* Prefill the badge/total quietly on load, without opening the drawer */
    fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (res) { return res.json(); })
      .then(function (cart) { fwRenderDrawer(cart); })
      .catch(function () {});

    var productJsonEl = document.getElementById('productJson-{{ section.id }}');
    var productData = productJsonEl ? JSON.parse(productJsonEl.textContent) : null;
    var form = section.querySelector('[data-product-form]');
    var variantIdInput = document.getElementById('variantId');
    var addBtn = document.getElementById('addToCart');
    var addNote = document.getElementById('addNote');

    var sizeButtons = section.querySelectorAll('.size-btn');
    sizeButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        sizeButtons.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
      });
    });

    var qtyInput = document.getElementById('qtyValue');
    document.getElementById('qtyMinus').addEventListener('click', function () {
      qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
    });
    document.getElementById('qtyPlus').addEventListener('click', function () {
      qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (addBtn.disabled) return;

      addBtn.disabled = true;
      var originalLabel = addBtn.querySelector('.btn-label').textContent;
      addBtn.querySelector('.btn-label').textContent = 'Adding…';
      addNote.textContent = '';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          id: variantIdInput.value,
          quantity: parseInt(qtyInput.value, 10) || 1
        })
      })
        .then(function (res) {
          if (!res.ok) return res.json().then(function (err) { throw err; });
          return res.json();
        })
        .then(function (item) {
          addNote.textContent = 'Added ' + item.quantity + ' item(s) to your cart.';
          return fetch('/cart.js').then(function (r) { return r.json(); });
        })
        .then(function (cart) {
          document.documentElement.dispatchEvent(
            new CustomEvent('cart:updated', { detail: { cart: cart }, bubbles: true })
          );
          var cartCountEls = document.querySelectorAll('[data-cart-count]');
          cartCountEls.forEach(function (el) { el.textContent = cart.item_count; });

          fwRenderDrawer(cart);
          fwOpenDrawer();
        })
        .catch(function (err) {
          addNote.textContent = (err && err.description) || 'Could not add this item to your cart.';
        })
        .finally(function () {
          addBtn.disabled = false;
          addBtn.querySelector('.btn-label').textContent = originalLabel;
        });
    });
  })();
</script>

{%- assign product_json_id = 'productJson-' | append: section.id -%}
{{ product | json | script_tag: id: product_json_id }}

