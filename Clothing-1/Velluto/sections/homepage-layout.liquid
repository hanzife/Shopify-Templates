<div class="velluto-homepage-wrapper">
    {%- comment -%}
        HERO VIEWFINDER
        One 16:9 image uploaded from the theme editor. Every tile shows its own
        slice of that same image, so the 5 tiles rebuild the full picture.
    {%- endcomment -%}
    {%- assign hero_image = section.settings.hero_image -%}
    {%- if hero_image != blank -%}
        {%- assign hero_pos = hero_image.presentation.focal_point | default: '50% 50%' -%}
        {%- capture hero_srcset -%}
            {{ hero_image | image_url: width: 1200 }} 1200w,
            {{ hero_image | image_url: width: 1800 }} 1800w
            {%- if hero_image.width >= 2400 -%}, {{ hero_image | image_url: width: 2400 }} 2400w{%- endif -%}
            {%- if hero_image.width >= 3200 -%}, {{ hero_image | image_url: width: 3200 }} 3200w{%- endif -%}
        {%- endcapture -%}
    {%- endif -%}

    <section class="hero-viewfinder" id="HeroViewfinder" data-hero-viewfinder aria-label="Collection preview">
        <div class="hero-viewfinder__spacer">
            <div class="hero-viewfinder__pin">
                <div class="hero-viewfinder__stage" data-hero-stage>
                    <ul class="hero-viewfinder__grid" data-hero-grid role="list">
                        {%- for i in (1..5) -%}
                            {%- assign label_key = 'label_' | append: i -%}
                            {%- assign tile_label = section.settings[label_key] | default: 'Explore' -%}
                            <li class="hero-tile hero-tile--{{ i }}" data-hero-tile data-index="{{ forloop.index0 }}">
                                <button type="button" class="hero-tile__hit" data-hero-tile-hit aria-label="{{ tile_label | escape }}">
                                    <span class="hero-tile__media">
                                        {%- if hero_image != blank -%}
                                            <img
                                                class="hero-tile__img"
                                                data-hero-tile-img
                                                src="{{ hero_image | image_url: width: 2400 }}"
                                                srcset="{{ hero_srcset | strip_newlines }}"
                                                sizes="100vw"
                                                alt=""
                                                style="--tile-pos: {{ hero_pos }};"
                                                draggable="false"
                                                loading="eager"
                                                {% if i == 1 %}fetchpriority="high"{% endif %}
                                            >
                                        {%- else -%}
                                            {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-tile__img hero-tile__img--placeholder' }}
                                        {%- endif -%}
                                    </span>
                                    <span class="hero-tile__overlay" aria-hidden="true"></span>
                                    <span class="hero-tile__label" data-hero-tile-label aria-hidden="true">{{ tile_label }}</span>
                                </button>
                            </li>
                        {%- endfor -%}
                    </ul>
                </div>
            </div>
        </div>
    </section>


<script>
(function () {
    const hero = document.querySelector('#HeroViewfinder');

    if (!hero) return;

    let isTransitioning = false;

    function getNextSection() {
        /*
         * Find the Shopify section wrapper containing the Hero.
         */
        const heroSection = hero.closest('[id^="shopify-section-"]');

        if (!heroSection) return null;

        /*
         * The immediate next Shopify section is the destination.
         * Do NOT search further down the page.
         */
        const nextSection = heroSection.nextElementSibling;

        if (
            nextSection &&
            nextSection.id &&
            nextSection.id.startsWith('shopify-section-')
        ) {
            return nextSection;
        }

        return null;
    }

    function easeInOut(t) {
        return t < 0.5
            ? 4 * t * t * t
            : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function smoothScrollTo(targetY, duration) {
        const startY = window.scrollY;
        const distance = targetY - startY;
        const startTime = performance.now();

        function animate(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = easeInOut(progress);

            window.scrollTo(
                0,
                startY + distance * eased
            );

            if (progress < 1) {
                requestAnimationFrame(animate);
            } else {
                isTransitioning = false;
            }
        }

        requestAnimationFrame(animate);
    }

    function goToNextSection() {
        const nextSection = getNextSection();

        if (!nextSection || isTransitioning) return;

        isTransitioning = true;

        const targetY =
            nextSection.getBoundingClientRect().top +
            window.scrollY;

        smoothScrollTo(targetY, 900);
    }

    function goToHero() {
        if (isTransitioning) return;

        isTransitioning = true;

        smoothScrollTo(0, 900);
    }

    window.addEventListener('wheel', function (event) {

        if (isTransitioning) {
            event.preventDefault();
            return;
        }

        const heroRect = hero.getBoundingClientRect();

        const heroAtTop =
            Math.abs(heroRect.top) < 5;

        /*
         * HERO -> IMMEDIATE NEXT SECTION
         */
        if (
            event.deltaY > 0 &&
            heroAtTop
        ) {
            event.preventDefault();
            goToNextSection();
            return;
        }

        /*
         * IMMEDIATE NEXT SECTION -> HERO
         */
        const nextSection = getNextSection();

        if (
            event.deltaY < 0 &&
            nextSection &&
            Math.abs(nextSection.getBoundingClientRect().top) < 5
        ) {
            event.preventDefault();
            goToHero();
        }

    }, { passive: false });

})();
</script>

</div>

{% schema %}
{
  "name": "Velluto Homepage",
  "class": "velluto-full-width-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (16:9)",
      "info": "Upload ONE landscape 16:9 image, e.g. 2560 x 1440px. It is sliced automatically across the 5 tiles. Use the focal point in the picker to control the crop."
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Tile 1 hover label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Tile 2 hover label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Tile 3 hover label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "label_4",
      "label": "Tile 4 hover label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "label_5",
      "label": "Tile 5 hover label",
      "default": "Explore"
    }
  ],
  "presets": [
    {
      "name": "Velluto Homepage"
    }
  ]
}
{% endschema %}